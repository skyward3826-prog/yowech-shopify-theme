<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f2eb">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'mobile-menu.css' | asset_url | stylesheet_tag }}
    {{ 'homepage-reference.css' | asset_url | stylesheet_tag }}
    {{ 'product-catalog.css' | asset_url | stylesheet_tag }}
    {{ 'contact-page.css' | asset_url | stylesheet_tag }}
    {% render 'seo-schema' %}
    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'header' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% section 'footer' %}
  </body>
</html>