<style>
.about-v2{background:#fff;color:#173d39}.about-v2 .about-wrap{width:min(calc(100% - 48px),1320px);margin:auto}.about-v2 .eyebrow{margin:0 0 10px;color:#526b62;font-size:11px;font-weight:700;letter-spacing:.16em}.about-v2 h1,.about-v2 h2,.about-v2 h3,.about-v2 p{margin-top:0}.about-v2 h1{font-size:clamp(42px,5vw,68px);line-height:1.02;letter-spacing:-.045em;margin-bottom:18px}.about-v2 h2{font-size:clamp(30px,3vw,42px);line-height:1.08;letter-spacing:-.035em;margin-bottom:12px}.about-v2 p{color:#5e6a66;font-size:14px;line-height:1.6}.about-v2 .btn{display:inline-block;padding:13px 22px;background:#123e39;color:#fff;font-size:13px;font-weight:600}.about-v2 .btn.light{background:#fff;color:#173d39}.about-v2 .hero{position:relative;min-height:500px;background:#e9e6de center/cover no-repeat;overflow:hidden}.about-v2 .hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(248,246,241,.98) 0%,rgba(248,246,241,.9) 35%,rgba(248,246,241,.28) 66%,rgba(248,246,241,0) 100%)}.about-v2 .hero-inner{position:relative;z-index:1;min-height:500px;display:flex;align-items:center}.about-v2 .hero-copy{max-width:590px}.about-v2 .hero-lead{max-width:540px;margin-bottom:25px}.about-v2 .hero-points{display:flex;flex-wrap:wrap;gap:26px;margin-top:28px;color:#173d39;font-size:12px;font-weight:600}.about-v2 .company{display:grid;grid-template-columns:1.05fr 1.15fr;gap:48px;align-items:center;padding:58px 0}.about-v2 .company-img{aspect-ratio:1.55/1;overflow:hidden;background:#ebe8e1}.about-v2 .company-img img{width:100%;height:100%;object-fit:cover}.about-v2 .stats{display:grid;grid-template-columns:repeat(4,1fr);margin-top:30px;border-top:1px solid #d9dfdb;padding-top:20px}.about-v2 .stat{padding-right:18px;border-right:1px solid #d9dfdb}.about-v2 .stat:last-child{border-right:0;padding-left:18px}.about-v2 .stat strong{display:block;font-size:28px;color:#173d39;line-height:1}.about-v2 .stat span{display:block;margin-top:7px;color:#5e6a66;font-size:11px}.about-v2 .why{background:#edf4ef;padding:38px 0}.about-v2 .why-inner{display:grid;grid-template-columns:1fr 2.5fr;gap:45px;align-items:center}.about-v2 .why-grid{display:grid;grid-template-columns:repeat(4,1fr)}.about-v2 .why-item{padding:6px 22px;text-align:center;border-left:1px solid #d1ddd6}.about-v2 .icon{font-size:30px;line-height:1;margin-bottom:12px}.about-v2 .why-item h3,.about-v2 .value-item h3{font-size:13px;margin-bottom:5px}.about-v2 .why-item p,.about-v2 .value-item p{font-size:11px;line-height:1.45;margin:0}.about-v2 .factory{padding:55px 0}.about-v2 .factory-layout{display:grid;grid-template-columns:.8fr 2.2fr;gap:38px;align-items:center}.about-v2 .factory-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.about-v2 .factory-card{min-width:0}.about-v2 .factory-card img{width:100%;aspect-ratio:1/1;object-fit:cover;background:#ebe8e1}.about-v2 .factory-card p{font-size:11px;font-weight:600;color:#173d39;margin:7px 0 0}.about-v2 .values{background:#f7f5ef;padding:40px 0}.about-v2 .values-inner{display:grid;grid-template-columns:1fr 2.5fr;gap:45px;align-items:center}.about-v2 .value-grid{display:grid;grid-template-columns:repeat(4,1fr)}.about-v2 .value-item{text-align:center;padding:5px 18px;border-left:1px solid #dddcd4}.about-v2 .cert-global{padding:55px 0;display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}.about-v2 .cert-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:24px}.about-v2 .cert-card{aspect-ratio:1.18/1;background:#fafafa;border:1px solid #d8ded9;display:flex;align-items:center;justify-content:center;overflow:hidden}.about-v2 .cert-card img{width:100%;height:100%;object-fit:contain;padding:12px}.about-v2 .map-card{margin-top:20px;overflow:hidden;background:#eef3f0}.about-v2 .map-card img{width:100%;max-height:220px;object-fit:cover}.about-v2 .cta{min-height:190px;background:#123f39 center/cover no-repeat;position:relative;color:#fff;overflow:hidden}.about-v2 .cta:after{content:"";position:absolute;inset:0;background:rgba(5,48,43,.72)}.about-v2 .cta-inner{position:relative;z-index:1;min-height:190px;display:flex;align-items:center;justify-content:space-between;gap:30px}.about-v2 .cta h2{color:#fff;margin-bottom:8px}.about-v2 .cta p{color:#dce6e1;margin:0}.about-v2 .cta .eyebrow{color:#dce6e1}.about-v2 .empty{background:#eeeae2;display:flex;align-items:center;justify-content:center;color:#7b817c;font-size:12px;min-height:200px}
@media(max-width:900px){.about-v2 .about-wrap{width:min(calc(100% - 32px),720px)}.about-v2 .hero,.about-v2 .hero-inner{min-height:560px}.about-v2 .company,.about-v2 .factory-layout,.about-v2 .why-inner,.about-v2 .values-inner,.about-v2 .cert-global{grid-template-columns:1fr}.about-v2 .why-grid,.about-v2 .value-grid{grid-template-columns:repeat(2,1fr);gap:20px}.about-v2 .factory-grid{grid-template-columns:repeat(2,1fr)}.about-v2 .why-item:nth-child(odd),.about-v2 .value-item:nth-child(odd){border-left:0}.about-v2 .cta-inner{align-items:flex-start;flex-direction:column;justify-content:center;padding:38px 0}}
@media(max-width:560px){.about-v2 h1{font-size:39px}.about-v2 .hero-points{display:grid;gap:10px}.about-v2 .stats{grid-template-columns:repeat(2,1fr);gap:18px}.about-v2 .stat:nth-child(2){border-right:0}.about-v2 .why-grid,.about-v2 .value-grid,.about-v2 .factory-grid,.about-v2 .cert-grid{grid-template-columns:1fr}.about-v2 .why-item,.about-v2 .value-item{border-left:0;border-top:1px solid #d7dfd9;padding:20px 8px}.about-v2 .cert-card{aspect-ratio:1.5/1}}
</style>

<section class="about-v2">
  <div class="hero"{% if section.settings.hero_image != blank %} style="background-image:url('{{ section.settings.hero_image | image_url: width: 2200 }}')"{% endif %}>
    <div class="about-wrap hero-inner"><div class="hero-copy"><p class="eyebrow">{{ section.settings.hero_eyebrow }}</p><h1>{{ section.settings.hero_title }}</h1><p class="hero-lead">{{ section.settings.hero_text }}</p>{% if section.settings.hero_button != blank %}<a class="btn" href="{{ section.settings.hero_button_link }}">{{ section.settings.hero_button }}</a>{% endif %}<div class="hero-points"><span>{{ section.settings.hero_point_1 }}</span><span>{{ section.settings.hero_point_2 }}</span><span>{{ section.settings.hero_point_3 }}</span></div></div></div>
  </div>

  <div class="about-wrap company">
    <div class="company-img">{% if section.settings.company_image != blank %}<img src="{{ section.settings.company_image | image_url: width: 1400 }}" alt="YOWECH company" loading="lazy">{% else %}<div class="empty">Upload company image</div>{% endif %}</div>
    <div><p class="eyebrow">{{ section.settings.company_eyebrow }}</p><h2>{{ section.settings.company_title }}</h2><p>{{ section.settings.company_text }}</p><div class="stats"><div class="stat"><strong>{{ section.settings.stat_1_value }}</strong><span>{{ section.settings.stat_1_label }}</span></div><div class="stat"><strong>{{ section.settings.stat_2_value }}</strong><span>{{ section.settings.stat_2_label }}</span></div><div class="stat"><strong>{{ section.settings.stat_3_value }}</strong><span>{{ section.settings.stat_3_label }}</span></div><div class="stat"><strong>{{ section.settings.stat_4_value }}</strong><span>{{ section.settings.stat_4_label }}</span></div></div></div>
  </div>

  <div class="why"><div class="about-wrap why-inner"><div><p class="eyebrow">{{ section.settings.why_eyebrow }}</p><h2>{{ section.settings.why_title }}</h2></div><div class="why-grid">{% for block in section.blocks %}{% if block.type == 'benefit' %}<div class="why-item" {{ block.shopify_attributes }}><div class="icon">{{ block.settings.icon }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endif %}{% endfor %}</div></div></div>

  <div class="about-wrap factory"><div class="factory-layout"><div><p class="eyebrow">{{ section.settings.factory_eyebrow }}</p><h2>{{ section.settings.factory_title }}</h2><p>{{ section.settings.factory_text }}</p>{% if section.settings.factory_button != blank %}<a class="btn" href="{{ section.settings.factory_button_link }}">{{ section.settings.factory_button }}</a>{% endif %}</div><div class="factory-grid"><div class="factory-card">{% if section.settings.factory_image_1 != blank %}<img src="{{ section.settings.factory_image_1 | image_url: width: 800 }}" alt="Modern production line" loading="lazy">{% endif %}<p>{{ section.settings.factory_caption_1 }}</p></div><div class="factory-card">{% if section.settings.factory_image_2 != blank %}<img src="{{ section.settings.factory_image_2 | image_url: width: 800 }}" alt="Quality control" loading="lazy">{% endif %}<p>{{ section.settings.factory_caption_2 }}</p></div><div class="factory-card">{% if section.settings.factory_image_3 != blank %}<img src="{{ section.settings.factory_image_3 | image_url: width: 800 }}" alt="Efficient manufacturing" loading="lazy">{% endif %}<p>{{ section.settings.factory_caption_3 }}</p></div><div class="factory-card">{% if section.settings.factory_image_4 != blank %}<img src="{{ section.settings.factory_image_4 | image_url: width: 800 }}" alt="Stable supply capacity" loading="lazy">{% endif %}<p>{{ section.settings.factory_caption_4 }}</p></div></div></div></div>

  <div class="values"><div class="about-wrap values-inner"><div><p class="eyebrow">{{ section.settings.values_eyebrow }}</p><h2>{{ section.settings.values_title }}</h2><p>{{ section.settings.values_text }}</p></div><div class="value-grid">{% for block in section.blocks %}{% if block.type == 'value' %}<div class="value-item" {{ block.shopify_attributes }}><div class="icon">{{ block.settings.icon }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endif %}{% endfor %}</div></div></div>

  <div class="about-wrap cert-global"><div><p class="eyebrow">{{ section.settings.cert_eyebrow }}</p><h2>{{ section.settings.cert_title }}</h2><p>{{ section.settings.cert_text }}</p><div class="cert-grid"><div class="cert-card">{% if section.settings.cert_image_1 != blank %}<img src="{{ section.settings.cert_image_1 | image_url: width: 600 }}" alt="Certification 1" loading="lazy">{% endif %}</div><div class="cert-card">{% if section.settings.cert_image_2 != blank %}<img src="{{ section.settings.cert_image_2 | image_url: width: 600 }}" alt="Certification 2" loading="lazy">{% endif %}</div><div class="cert-card">{% if section.settings.cert_image_3 != blank %}<img src="{{ section.settings.cert_image_3 | image_url: width: 600 }}" alt="Certification 3" loading="lazy">{% endif %}</div><div class="cert-card">{% if section.settings.cert_image_4 != blank %}<img src="{{ section.settings.cert_image_4 | image_url: width: 600 }}" alt="Certification 4" loading="lazy">{% endif %}</div></div></div><div><p class="eyebrow">{{ section.settings.global_eyebrow }}</p><h2>{{ section.settings.global_title }}</h2><p>{{ section.settings.global_text }}</p><div class="map-card">{% if section.settings.global_image != blank %}<img src="{{ section.settings.global_image | image_url: width: 1400 }}" alt="Global customer reach map" loading="lazy">{% endif %}</div></div></div>

  <div class="cta"{% if section.settings.cta_image != blank %} style="background-image:url('{{ section.settings.cta_image | image_url: width: 2200 }}')"{% endif %}><div class="about-wrap cta-inner"><div><p class="eyebrow">{{ section.settings.cta_eyebrow }}</p><h2>{{ section.settings.cta_title }}</h2><p>{{ section.settings.cta_text }}</p></div>{% if section.settings.cta_button != blank %}<a class="btn light" href="{{ section.settings.cta_button_link }}">{{ section.settings.cta_button }}</a>{% endif %}</div></div>
</section>

