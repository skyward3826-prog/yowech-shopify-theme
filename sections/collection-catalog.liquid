<style>
.collection-catalog-section{background:#fff}.collection-catalog-section *{box-sizing:border-box}.collection-reference__body{padding:18px 0 55px}.collection-reference__crumbs{font-size:11px;color:#6d746f;margin-bottom:18px}.collection-reference__catalog{display:grid;grid-template-columns:205px minmax(0,1fr);gap:28px}.collection-reference__sidebar{padding-right:6px}.collection-filter-group{border-bottom:1px solid #ddd9d0;padding:0 0 17px;margin-bottom:16px}.collection-filter-title{display:flex;align-items:center;justify-content:space-between;margin:0 0 12px;font-size:14px;font-weight:600}.collection-filter-title span{font-size:18px;font-weight:400;color:#6d746f}.collection-category-list{display:grid;gap:9px}.collection-category-list a{display:flex;align-items:center;gap:9px;font-size:12px;color:#303633}.collection-category-list a:before{content:"";width:13px;height:13px;border:1px solid #bfc5c0;display:inline-block;flex:0 0 13px}.collection-category-list a.is-active{font-weight:600;color:#173b36}.collection-category-list a.is-active:before{box-shadow:inset 0 0 0 3px #fff;background:#173b36}.collection-filter-toggle{display:flex;justify-content:space-between;align-items:center;width:100%;border:0;background:none;padding:0;text-align:left;font:inherit;cursor:pointer}.collection-filter-toggle:after{content:"+";font-size:18px;font-weight:300;color:#6d746f}.collection-filter-content{display:none;padding-top:12px}.collection-filter-group.is-open .collection-filter-content{display:grid;gap:7px}.collection-filter-option{font-size:11px;color:#59615c}.collection-filter-option input{margin-right:7px}.collection-sidebar-cta{margin-top:24px;padding:20px 16px;background:#edf3ee;overflow:hidden}.collection-sidebar-cta h3{margin:0;font-size:19px;line-height:1.15;color:#173b36}.collection-sidebar-cta p{margin:10px 0 14px;font-size:11px;color:#59645f}.collection-sidebar-cta a{display:inline-block;padding:10px 14px;background:#173b36;color:#fff;font-size:11px}.collection-reference__toolbar{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:17px;color:#59615c;font-size:11px}.collection-reference__toolbar-right{display:flex;align-items:center;gap:12px}.collection-reference__sort{border:1px solid #d8dcd8;background:#fff;padding:9px 12px;font-size:11px;color:#303633}.collection-reference__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:25px 18px}.collection-reference__grid .product-card-copy{padding-top:9px}.collection-reference__grid .product-category{font-size:9px}.collection-reference__grid .product-card h3{font-size:12px;line-height:1.3}.collection-reference__grid .product-meta{display:block;margin-top:6px;font-size:10px}.collection-reference__grid .product-meta span:first-child{display:none}.collection-reference__grid .product-meta span:last-child{color:#737a76}.collection-reference__grid .product-detail-link{display:none}.collection-reference__grid .product-image{aspect-ratio:1/1;background:#f2f2ef}.collection-reference__grid .product-image img{object-fit:cover}.collection-reference__empty{padding:60px 30px;border:1px dashed #ddd9d0;text-align:center;color:#6d746f}.collection-reference__pagination{display:flex;justify-content:center;gap:10px;margin-top:30px}.collection-reference__pagination a,.collection-reference__pagination span{min-width:32px;height:32px;display:grid;place-items:center;border:1px solid #e0e2df;font-size:11px}.collection-reference__pagination .current{background:#173b36;color:#fff;border-color:#173b36}.collection-reference__seo{margin-top:48px;border-top:1px solid #ddd9d0;padding-top:35px;max-width:850px}.collection-reference__seo h2{margin:0 0 10px;font-size:24px;color:#173b36}.collection-reference__seo p{margin:0;color:#6d746f;font-size:13px}@media(max-width:900px){.collection-reference__catalog{grid-template-columns:1fr}.collection-reference__sidebar{display:none}.collection-reference__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 12px}.collection-reference__toolbar{flex-wrap:wrap}}
</style>

<section class="collection-catalog-section">
  <div class="container collection-reference__body">
    <div class="collection-reference__crumbs">{% render 'breadcrumbs' %}</div>
    <div class="collection-reference__catalog">
      <aside class="collection-reference__sidebar" aria-label="Product filters">
        <div class="collection-filter-group">
          <h2 class="collection-filter-title">Product Categories <span>−</span></h2>
          <nav class="collection-category-list">
            <a href="{{ routes.all_products_collection_url }}" {% if collection.handle == 'all' or collection.handle == 'products' %}class="is-active"{% endif %}>All Products</a>
            <a href="/collections/silicone-kitchenware" {% if collection.handle == 'silicone-kitchenware' %}class="is-active"{% endif %}>Silicone Kitchenware</a>
            <a href="/collections/silicone-food-storage" {% if collection.handle == 'silicone-food-storage' %}class="is-active"{% endif %}>Silicone Food Storage</a>
            <a href="/collections/silicone-baby-products" {% if collection.handle == 'silicone-baby-products' %}class="is-active"{% endif %}>Silicone Baby Products</a>
            <a href="/collections/silicone-pet-products" {% if collection.handle == 'silicone-pet-products' %}class="is-active"{% endif %}>Silicone Pet Products</a>
            <a href="/collections/silicone-household-products" {% if collection.handle == 'silicone-household-products' %}class="is-active"{% endif %}>Silicone Household Products</a>
            <a href="/collections/silicone-bathroom-products" {% if collection.handle == 'silicone-bathroom-products' %}class="is-active"{% endif %}>Silicone Bathroom Products</a>
            <a href="/collections/silicone-beauty-products" {% if collection.handle == 'silicone-beauty-products' %}class="is-active"{% endif %}>Silicone Beauty Products</a>
            <a href="/collections/silicone-outdoor-sports" {% if collection.handle == 'silicone-outdoor-sports' %}class="is-active"{% endif %}>Silicone Outdoor &amp; Sports</a>
          </nav>
        </div>

        {% if collection.filters.size > 0 %}
          {% for filter in collection.filters %}
            <div class="collection-filter-group">
              <button type="button" class="collection-filter-toggle" onclick="this.parentElement.classList.toggle('is-open')"><span>{{ filter.label }}</span></button>
              <div class="collection-filter-content">
                {% for value in filter.values limit:10 %}
                  <label class="collection-filter-option"><input type="checkbox"{% if value.active %} checked{% endif %} disabled> {{ value.label }}{% if value.count %} ({{ value.count }}){% endif %}</label>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% assign fallback_filters = 'Product Type|Application|Color|Material|Certification|Custom Service|Price Range' | split: '|' %}
          {% for filter_name in fallback_filters %}
            <div class="collection-filter-group"><button type="button" class="collection-filter-toggle" onclick="this.parentElement.classList.toggle('is-open')"><span>{{ filter_name }}</span></button></div>
          {% endfor %}
        {% endif %}

        <div class="collection-sidebar-cta">
          <h3>Looking for Custom Products?</h3>
          <p>We provide OEM &amp; ODM services to bring your ideas to life.</p>
          <a href="/pages/oem-odm">Learn More</a>
        </div>
      </aside>

      <main>
        <div class="collection-reference__toolbar">
          <span>Showing {{ collection.products_count }} products</span>
          <div class="collection-reference__toolbar-right"><span>Wholesale inquiry only</span><select class="collection-reference__sort" aria-label="Sort products" onchange="if(this.value) window.location=this.value"><option value="{{ collection.url }}?sort_by=manual">Sort by: Featured</option><option value="{{ collection.url }}?sort_by=created-descending">Newest</option><option value="{{ collection.url }}?sort_by=price-ascending">Price: Low to High</option><option value="{{ collection.url }}?sort_by=price-descending">Price: High to Low</option></select></div>
        </div>

        {% paginate collection.products by 24 %}
          {% if collection.products_count > 0 %}
            <div class="collection-reference__grid">
              {% for product in collection.products %}{% render 'product-card', product: product %}{% endfor %}
            </div>
            {% if paginate.pages > 1 %}
              <nav class="collection-reference__pagination" aria-label="Pagination">
                {% if paginate.previous %}<a href="{{ paginate.previous.url }}">‹</a>{% endif %}
                {% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}">{{ part.title }}</a>{% else %}<span class="current">{{ part.title }}</span>{% endif %}{% endfor %}
                {% if paginate.next %}<a href="{{ paginate.next.url }}">›</a>{% endif %}
              </nav>
            {% endif %}
          {% else %}<div class="collection-reference__empty">Products will appear here as you add them in Shopify.</div>{% endif %}
        {% endpaginate %}

        <section class="collection-reference__seo"><h2>{% if collection.handle == 'all' or collection.handle == 'products' %}Silicone Products{% else %}{{ collection.title }}{% endif %} for Wholesale &amp; OEM</h2><p>Source silicone products for wholesale distribution, retail programs, private label and custom development. Contact our team for product specifications, MOQ, packaging, branding and bulk pricing.</p></section>
      </main>
    </div>
  </div>
</section>

{% schema %}
{"name":"Product catalog","settings":[],"presets":[{"name":"Product catalog"}]}
{% endschema %}