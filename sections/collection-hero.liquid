<section class="collection-reference collection-hero-section">
  <div class="collection-reference__hero{% if section.settings.hero_image == blank %} collection-reference__hero--no-image{% endif %}">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', alt: section.settings.title | escape }}
    {% endif %}
    <div class="container collection-reference__hero-inner">
      <div class="collection-reference__hero-copy">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.title }}</h1>
        <h2>{{ section.settings.subtitle }}</h2>
        <p>{{ section.settings.description }}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .collection-reference__hero{position:relative;min-height:420px;background:#eeeae2;overflow:hidden}
  .collection-reference__hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .collection-reference__hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(247,244,238,.97) 0%,rgba(247,244,238,.88) 27%,rgba(247,244,238,.42) 50%,rgba(247,244,238,.04) 74%,rgba(247,244,238,0) 100%);pointer-events:none}
  .collection-reference__hero--no-image:after{display:none}
  .collection-reference__hero-inner{position:relative;z-index:1;min-height:420px;display:flex;align-items:center}
  .collection-reference__hero-copy{max-width:650px;padding:48px 0}
  .collection-reference__hero-copy h1{margin:0;color:#173b36;font-size:clamp(44px,5vw,68px);line-height:1;letter-spacing:-.045em}
  .collection-reference__hero-copy h2{margin:18px 0 0;max-width:680px;color:#17231f;font-size:clamp(22px,2.4vw,34px);line-height:1.15;letter-spacing:-.025em}
  .collection-reference__hero-copy>p:last-child{margin:18px 0 0;max-width:610px;color:#4f5752;font-size:15px;line-height:1.6}
  @media(max-width:749px){.collection-reference__hero{min-height:460px}.collection-reference__hero>img{object-position:62% center}.collection-reference__hero:after{background:linear-gradient(90deg,rgba(247,244,238,.96),rgba(247,244,238,.72) 58%,rgba(247,244,238,.18))}.collection-reference__hero-inner{min-height:460px}.collection-reference__hero-copy{padding:34px 0}.collection-reference__hero-copy h1{font-size:48px}.collection-reference__hero-copy h2{font-size:24px}.collection-reference__hero-copy>p:last-child{font-size:13px}}
</style>

{% schema %}
{
  "name": "Collection hero",
  "settings": [
    {"type":"image_picker","id":"hero_image","label":"Collection hero image","info":"Upload a dedicated wide banner for this collection."},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHOLESALE SILICONE PRODUCTS"},
    {"type":"text","id":"title","label":"Main title","default":"Products"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"A Wide Range of Silicone Products for Global Markets"},
    {"type":"textarea","id":"description","label":"Description","default":"Explore our full range of silicone products for home, kitchen, baby, pet, beauty, outdoor and more. High quality, wholesale supply, and OEM & ODM services."}
  ],
  "presets": [{"name":"Collection hero"}]
}
{% endschema %}