<section class="contact-methods">
  <div class="container">
    <div class="contact-methods__grid">
      {% for block in section.blocks %}
        <a class="contact-methods__card" href="{{ block.settings.link | escape }}" {% if block.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %} {{ block.shopify_attributes }}>
          <span class="contact-methods__icon">
            {% if block.settings.icon != blank %}
              {{ block.settings.icon | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,120,160', sizes: '52px', alt: block.settings.title }}
            {% else %}
              <span>{{ block.settings.fallback }}</span>
            {% endif %}
          </span>
          <span class="contact-methods__copy">
            <small class="contact-methods__label">{{ block.settings.label }}</small>
            <strong class="contact-methods__title">{{ block.settings.title }}</strong>
            <em class="contact-methods__text">{{ block.settings.text }}</em>
          </span>
          {% if block.settings.show_arrow %}<span class="contact-methods__arrow">→</span>{% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.contact-methods{padding:24px 0 30px;background:#fff}.contact-methods__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.contact-methods__card{position:relative;display:flex;align-items:center;gap:16px;min-height:128px;padding:22px 20px;background:#f8fafb;border:1px solid #e5ebe8;box-shadow:0 8px 24px rgba(23,59,54,.055);color:#173b36;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}.contact-methods__card:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(23,59,54,.10);border-color:#cfdcd6}.contact-methods__icon{width:58px;height:58px;flex:0 0 58px;border-radius:50%;display:grid;place-items:center;background:#dcebe4;color:#173b36;overflow:hidden}.contact-methods__card:nth-child(2) .contact-methods__icon{background:#d9eadc}.contact-methods__card:nth-child(3) .contact-methods__icon{background:#e4edf4}.contact-methods__card:nth-child(4) .contact-methods__icon{background:#dce7ee}.contact-methods__icon img{width:36px;height:36px;object-fit:contain}.contact-methods__icon>span{font-size:20px;font-weight:700}.contact-methods__copy{min-width:0;padding-right:16px}.contact-methods__label{display:block;margin:0 0 5px;color:#68746e;font-size:11px;font-weight:700;letter-spacing:.10em;text-transform:uppercase}.contact-methods__title{display:block;font-size:16px;font-weight:700;line-height:1.3}.contact-methods__text{display:block;margin-top:6px;color:#68746e;font-size:12px;line-height:1.45;font-style:normal}.contact-methods__arrow{position:absolute;right:15px;bottom:13px;font-size:18px;color:#173b36}
/* Keep the legacy contact section's internal methods below the hero from rendering twice. */
.contact-reference>.contact-reference__hero,.contact-reference>.container:has(.contact-reference__methods),.contact-reference>.contact-reference__cta{display:none!important}
@media(max-width:900px){.contact-methods__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.contact-methods{padding:14px 0 24px}.contact-methods__grid{grid-template-columns:1fr}.contact-methods__card{min-height:110px;padding:18px}.contact-methods__icon{width:50px;height:50px;flex-basis:50px}}
</style>

{% schema %}
{"name":"Contact methods","max_blocks":4,"settings":[],"blocks":[{"type":"method","name":"Contact method","settings":[{"type":"image_picker","id":"icon","label":"Icon","info":"Upload the matching Email, WhatsApp, Facebook or LinkedIn icon."},{"type":"text","id":"fallback","label":"Fallback icon text","default":"@"},{"type":"text","id":"label","label":"Label","default":"EMAIL US"},{"type":"text","id":"title","label":"Title","default":"sales@yowech.com"},{"type":"textarea","id":"text","label":"Description","default":"Send us an email anytime."},{"type":"text","id":"link","label":"Contact link","default":"mailto:sales@yowech.com","info":"Email: mailto:address. For WhatsApp/Facebook/LinkedIn, paste the full destination URL."},{"type":"checkbox","id":"new_tab","label":"Open in new tab","default":false},{"type":"checkbox","id":"show_arrow","label":"Show arrow","default":true}]}],"presets":[{"name":"Contact methods","blocks":[{"type":"method","settings":{"fallback":"✉","label":"EMAIL US","title":"sales@yowech.com","text":"Send us an email anytime.","link":"mailto:sales@yowech.com","new_tab":false}},{"type":"method","settings":{"fallback":"◉","label":"CHAT ON WHATSAPP","title":"Chat with our sales team","text":"Get a faster response via WhatsApp.","link":"https://wa.me/","new_tab":true}},{"type":"method","settings":{"fallback":"f","label":"MESSAGE ON FACEBOOK","title":"Follow & message us","text":"Connect with our team online.","link":"https://facebook.com/","new_tab":true}},{"type":"method","settings":{"fallback":"in","label":"CONNECT ON LINKEDIN","title":"Connect with our team","text":"Build a long-term business relationship.","link":"https://linkedin.com/","new_tab":true}}]}]}
{% endschema %}