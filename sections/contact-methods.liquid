<section class="contact-methods">
  <div class="container">
    <div class="contact-methods__grid">
      {% for block in section.blocks %}
        <a class="contact-methods__card" {% if block.settings.title == 'WeChat' %}href="#wechat-copy" data-wechat-copy="+8613922907202" aria-label="Copy WeChat number +86 139 2290 7202"{% else %}href="{{ block.settings.link | escape }}"{% endif %} {% if block.settings.new_tab and block.settings.title != 'WeChat' %}target="_blank" rel="noopener noreferrer"{% endif %} {{ block.shopify_attributes }}>
          <span class="contact-methods__icon">
            {% if block.settings.title == 'WeChat' %}
              <svg class="contact-methods__wechat-icon" viewBox="0 0 48 48" role="img" aria-label="WeChat" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.1 8.2C12.6 8.2 5 14.1 5 21.3c0 4.1 2.4 7.8 6.2 10.1l-1.5 5.2 6.3-3.1c1.9.6 3.9.9 6.1.9.5 0 1 0 1.5-.1a11.7 11.7 0 0 1-.8-4.1c0-7 6.7-12.7 15-12.7.6 0 1.1 0 1.7.1C37.8 12.1 30.7 8.2 22.1 8.2Z" fill="currentColor"/>
                <path d="M28.8 21.1c-6.9 0-12.5 4.4-12.5 9.8s5.6 9.8 12.5 9.8c1.7 0 3.3-.3 4.8-.8l5 2.4-1.2-4.1c3-1.8 4.9-4.4 4.9-7.3 0-5.4-5.6-9.8-12.5-9.8Z" fill="#20a65a" stroke="#fff" stroke-width="1.2"/>
                <circle cx="17.3" cy="19.7" r="1.7" fill="#fff"/><circle cx="26.7" cy="19.7" r="1.7" fill="#fff"/>
                <circle cx="24.7" cy="29.1" r="1.5" fill="#fff"/><circle cx="33" cy="29.1" r="1.5" fill="#fff"/>
              </svg>
            {% elsif block.settings.icon != blank %}
              {{ block.settings.icon | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,120,160', sizes: '52px', alt: block.settings.title }}
            {% else %}
              <span>{{ block.settings.fallback }}</span>
            {% endif %}
          </span>
          <span class="contact-methods__copy">
            <small class="contact-methods__label">{{ block.settings.label }}</small>
            <strong class="contact-methods__title">{{ block.settings.title }}</strong>
            <em class="contact-methods__text">{{ block.settings.text }}</em>
          </span>
          {% if block.settings.show_arrow %}<span class="contact-methods__arrow">→</span>{% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.contact-methods{padding:24px 0 30px;background:#fff}.contact-methods__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.contact-methods__card{position:relative;display:flex;align-items:center;gap:16px;min-height:128px;padding:22px 20px;background:#f8fafb;border:1px solid #e5ebe8;box-shadow:0 8px 24px rgba(23,59,54,.055);color:#173b36;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}.contact-methods__card:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(23,59,54,.10);border-color:#cfdcd6}.contact-methods__icon{width:58px;height:58px;flex:0 0 58px;border-radius:50%;display:grid;place-items:center;background:#dcebe4;color:#173b36;overflow:hidden}.contact-methods__card:nth-child(2) .contact-methods__icon{background:#d9eadc}.contact-methods__card:nth-child(3) .contact-methods__icon{background:#e4edf4}.contact-methods__card:nth-child(4) .contact-methods__icon{background:#dce7ee}.contact-methods__icon img{width:36px;height:36px;object-fit:contain}.contact-methods__wechat-icon{width:38px;height:38px;display:block}.contact-methods__icon>span{font-size:20px;font-weight:700}.contact-methods__copy{min-width:0;padding-right:16px}.contact-methods__label{display:block;margin:0 0 5px;color:#68746e;font-size:11px;font-weight:700;letter-spacing:.10em;text-transform:uppercase}.contact-methods__title{display:block;font-size:16px;font-weight:700;line-height:1.3}.contact-methods__text{display:block;margin-top:6px;color:#68746e;font-size:12px;line-height:1.45;font-style:normal}.contact-methods__arrow{position:absolute;right:15px;bottom:13px;font-size:18px;color:#173b36}.contact-reference__methods{display:none!important}
@media(max-width:900px){.contact-methods__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.contact-methods{padding:14px 0 24px}.contact-methods__grid{grid-template-columns:1fr}.contact-methods__card{min-height:110px;padding:18px}.contact-methods__icon{width:50px;height:50px;flex-basis:50px}}
</style>

<script>
document.addEventListener('click', async function(event) {
  const card = event.target.closest('[data-wechat-copy]');
  if (!card) return;
  event.preventDefault();
  const number = card.getAttribute('data-wechat-copy');
  const description = card.querySelector('.contact-methods__text');
  try {
    await navigator.clipboard.writeText(number);
    if (description) description.textContent = 'WeChat number copied. Open WeChat and add us: +86 139 2290 7202';
  } catch (error) {
    if (description) description.textContent = 'WeChat: +86 139 2290 7202 — copy this number and search in WeChat.';
  }
});
</script>

{% schema %}
{"name":"Contact methods","max_blocks":5,"settings":[],"blocks":[{"type":"method","name":"Contact method","settings":[{"type":"image_picker","id":"icon","label":"Icon","info":"Upload the matching Email, WhatsApp, Facebook or LinkedIn icon."},{"type":"text","id":"fallback","label":"Fallback icon text","default":"@"},{"type":"text","id":"label","label":"Label","default":"EMAIL US"},{"type":"text","id":"title","label":"Title","default":"sales@yowech.com"},{"type":"textarea","id":"text","label":"Description","default":"Send us an email anytime."},{"type":"text","id":"link","label":"Contact link","default":"mailto:sales@yowech.com","info":"Email: mailto:address. For WhatsApp/Facebook/LinkedIn, paste the full destination URL."},{"type":"checkbox","id":"new_tab","label":"Open in new tab","default":false},{"type":"checkbox","id":"show_arrow","label":"Show arrow","default":true}]}],"presets":[{"name":"Contact methods","blocks":[{"type":"method","settings":{"fallback":"✉","label":"EMAIL US","title":"sales@yowech.com","text":"Send us an email anytime.","link":"mailto:sales@yowech.com","new_tab":false}},{"type":"method","settings":{"fallback":"◉","label":"CHAT ON WHATSAPP","title":"Chat with our sales team","text":"Get a faster response via WhatsApp.","link":"https://wa.me/","new_tab":true}},{"type":"method","settings":{"fallback":"f","label":"MESSAGE ON FACEBOOK","title":"Follow & message us","text":"Connect with our team online.","link":"https://facebook.com/","new_tab":true}},{"type":"method","settings":{"fallback":"in","label":"CONNECT ON LINKEDIN","title":"Connect with our team","text":"Build a long-term business relationship.","link":"https://linkedin.com/","new_tab":true}}]}]}
{% endschema %}