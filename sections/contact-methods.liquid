<style>
.contact-methods{padding:8px 0 30px;background:#fff}
.contact-methods__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.contact-methods__card{display:flex;align-items:center;gap:16px;min-height:116px;padding:22px 20px;background:#fff;border:1px solid #e7ece8;box-shadow:0 8px 24px rgba(23,59,54,.055);color:#173b36;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}
.contact-methods__card:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(23,59,54,.10)}
.contact-methods__icon{width:52px;height:52px;flex:0 0 52px;border-radius:50%;display:grid;place-items:center;background:#dcebe4;color:#173b36}
.contact-methods__icon svg{width:25px;height:25px;display:block}
.contact-methods__card:nth-child(2) .contact-methods__icon{background:#d9eadc}
.contact-methods__card:nth-child(3) .contact-methods__icon{background:#e4edf4}
.contact-methods__card:nth-child(4) .contact-methods__icon{background:#dce7ee}
.contact-methods__label{display:block;margin:0 0 5px;color:#68746e;font-size:11px;font-weight:600;letter-spacing:.10em;text-transform:uppercase}
.contact-methods__title{display:block;font-size:15px;font-weight:700;line-height:1.3}
.contact-methods__text{display:block;margin-top:6px;color:#68746e;font-size:11px;line-height:1.45}
.contact-reference__methods{display:none!important}
@media(max-width:900px){.contact-methods__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){.contact-methods{padding:4px 0 22px}.contact-methods__grid{grid-template-columns:1fr}.contact-methods__card{min-height:100px;padding:18px}.contact-methods__icon{width:48px;height:48px;flex-basis:48px}}
</style>

<section class="contact-methods">
  <div class="container">
    <div class="contact-methods__grid">
      <a class="contact-methods__card" href="mailto:{{ settings.email | escape }}">
        <span class="contact-methods__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="m4 7 8 6 8-6"></path></svg></span>
        <span><small class="contact-methods__label">Email Us</small><strong class="contact-methods__title">{{ settings.email | default: 'sales@yourdomain.com' }}</strong><em class="contact-methods__text">Send us an email anytime.</em></span>
      </a>

      <a class="contact-methods__card" href="{{ settings.whatsapp_url | default: '#' }}" {% if settings.whatsapp_url != blank %}target="_blank" rel="noopener"{% endif %}>
        <span class="contact-methods__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z"></path><path d="M8.5 8.8c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4-.1.6l-.5.6c.6 1 1.3 1.7 2.3 2.2l.6-.5c.2-.2.4-.2.6-.1l1.5.7c.3.1.4.3.4.5 0 .5-.2 1-.6 1.2-.4.2-1 .2-1.6 0-2.8-.9-5-3-5.9-5.8-.2-.5-.2-1.1 0-1.6.2-.4.6-.7.9-.8Z"></path></svg></span>
        <span><small class="contact-methods__label">Chat on WhatsApp</small><strong class="contact-methods__title">Chat with our sales team</strong><em class="contact-methods__text">Get a faster response via WhatsApp.</em></span>
      </a>

      <a class="contact-methods__card" href="{{ settings.facebook_url | default: '#' }}" {% if settings.facebook_url != blank %}target="_blank" rel="noopener"{% endif %}>
        <span class="contact-methods__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9V10H9v3h1.7v8h2.8Z"></path></svg></span>
        <span><small class="contact-methods__label">Message on Facebook</small><strong class="contact-methods__title">Follow &amp; message us</strong><em class="contact-methods__text">Connect with our team online.</em></span>
      </a>

      <a class="contact-methods__card" href="{{ settings.linkedin_url | default: '#' }}" {% if settings.linkedin_url != blank %}target="_blank" rel="noopener"{% endif %}>
        <span class="contact-methods__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M5.2 8.2H2.3V21h2.9V8.2ZM3.8 3A1.8 1.8 0 1 0 3.8 6.6 1.8 1.8 0 0 0 3.8 3ZM21.7 13.7c0-3.9-2.1-5.8-5-5.8-2.3 0-3.3 1.3-3.9 2.2V8.2H10V21h2.9v-6.3c0-1.7.3-3.3 2.4-3.3 2.1 0 2.1 1.9 2.1 3.4V21h2.9v-7.3Z"></path></svg></span>
        <span><small class="contact-methods__label">Connect on LinkedIn</small><strong class="contact-methods__title">Connect with our team</strong><em class="contact-methods__text">Build a long-term business relationship.</em></span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{"name":"Contact methods","settings":[]}
{% endschema %}