{% assign featured_collection = section.settings.collection %}
<section class="featured-section">
  <div class="container">
    <div class="section-heading section-heading-row">
      <div>
        <p class="eyebrow">SELECTED PRODUCTS</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {% if featured_collection != blank %}<a class="text-link" href="{{ featured_collection.url }}">View All Products →</a>{% endif %}
    </div>

    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="product-grid">
        {% for product in featured_collection.products limit: 8 %}
          <article class="product-card">
            <a class="product-image" href="{{ product.url }}">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 700 | image_tag: widths: '300,500,700', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
              {% else %}<div class="image-placeholder"><span>No image</span></div>{% endif %}
            </a>
            <div class="product-card-copy">
              <p class="product-category">{{ product.type }}</p>
              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <div class="product-meta">
                <span>{% if product.price_varies %}{{ product.price_min | money }} – {{ product.price_max | money }}{% else %}{{ product.price | money }}{% endif %}</span>
                {% if product.metafields.custom.moq.value != blank %}<span>MOQ {{ product.metafields.custom.moq.value }}</span>{% endif %}
              </div>
              <a class="product-detail-link" href="{{ product.url }}">View Details →</a>
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="section-placeholder">Select a Shopify collection in the section settings to display products here.</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Selected Silicone Products" },
    { "type": "collection", "id": "collection", "label": "Collection" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
