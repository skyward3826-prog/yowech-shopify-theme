<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 260 | image_tag: class: 'brand-logo', widths: '130,195,260', alt: shop.name }}
      {% else %}<span class="brand-text">{{ shop.name }}</span>{% endif %}
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }}</a>
      <a href="{{ routes.all_products_collection_url }}">{{ 'general.navigation.products' | t }}</a>
      <a href="/pages/oem-odm">{{ 'general.navigation.oem_odm' | t }}</a>
      <a href="/pages/wholesale">{{ 'general.navigation.wholesale' | t }}</a>
      <a href="/pages/about-us">{{ 'general.navigation.about_us' | t }}</a>
      <a href="/pages/contact-us">{{ 'general.navigation.contact_us' | t }}</a>
    </nav>
    <div class="header-actions">
      <a class="header-cta" href="/pages/contact-us">{{ 'general.navigation.request_quote' | t }}</a>
      {% render 'language-selector' %}
      {% render 'mobile-menu' %}
    </div>
  </div>
</header>