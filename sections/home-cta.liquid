<section class="home-cta">
  <div class="container home-cta-inner">
    <div>
      <p class="eyebrow">GLOBAL B2B SOURCING</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <a class="primary-link" href="/pages/contact-us">Request a Quote</a>
  </div>
</section>

{% schema %}
{
  "name": "Home inquiry CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Looking for a Reliable Silicone Product Partner?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tell us what you are looking for. We can help you source, customize and supply silicone products for your market." }
  ],
  "presets": [{ "name": "Home inquiry CTA" }]
}
{% endschema %}
