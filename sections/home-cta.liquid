<section class="home-cta home-cta--reference"{% if section.settings.image != blank %} style="--home-cta-image:url('{{ section.settings.image | image_url: width: 1800 }}')"{% endif %}>
  <div class="container home-cta-inner">
    <div>
      <p class="eyebrow">LET'S WORK TOGETHER</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <a class="home-cta-button" href="/pages/contact-us">Contact Us</a>
  </div>
</section>

{% schema %}
{
  "name": "Home inquiry CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Looking for a Reliable Silicone Products Supplier?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We're here to help. Contact us for product catalogs, pricing or custom requests." },
    { "type": "image_picker", "id": "image", "label": "CTA background image" }
  ],
  "presets": [{ "name": "Home inquiry CTA" }]
}
{% endschema %}
