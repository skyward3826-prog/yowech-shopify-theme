<section class="home-hero home-hero--reference">
  <div class="home-hero-media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '900,1200,1500,1800', loading: 'eager', alt: section.settings.image.alt | default: 'Global silicone products wholesale supplier' }}
    {% else %}
      <div class="image-placeholder"><span>Add hero image</span></div>
    {% endif %}
  </div>
  <div class="container home-hero-inner">
    <div class="home-hero-copy">
      <p class="eyebrow">GLOBAL SILICONE PRODUCTS</p>
      <h1>Global Silicone Products<br>for a Better Everyday Life</h1>
      <p class="hero-subline">Wide Range&nbsp; | &nbsp;OEM &amp; ODM&nbsp; | &nbsp;Wholesale Supply</p>
      <div class="hero-rule"></div>
      <p class="hero-lead">Your one-stop partner for high-quality silicone products across multiple categories.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "B2B Home Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    { "name": "B2B Home Hero" }
  ]
}
{% endschema %}
