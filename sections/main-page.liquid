<section class="page-section">
  <div class="container page-content">
    {% if section.settings.show_title %}
      <header class="page-header">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ page.title }}</h1>
      </header>
    {% endif %}
    <div class="page-richtext rte">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main page",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "YOWECH" }
  ]
}
{% endschema %}