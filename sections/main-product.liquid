<section class="product-page">
  <div class="container">
    <div class="product-layout">
      <div class="product-gallery">
        {% if product.images.size > 0 %}
          {% for image in product.images %}
            <div class="product-gallery-image">
              {{ image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,700,900,1200', alt: image.alt | default: product.title | escape }}
            </div>
          {% endfor %}
        {% else %}
          <div class="image-placeholder product-gallery-placeholder">Product images</div>
        {% endif %}
      </div>

      <aside class="product-info">
        {% if product.type != blank %}<p class="eyebrow">{{ product.type | escape }}</p>{% endif %}
        <h1>{{ product.title | escape }}</h1>
        <div class="product-price">
          {% if product.price_varies %}
            {{ product.price_min | money }} – {{ product.price_max | money }}
          {% else %}
            {{ product.price | money }}
          {% endif %}
        </div>
        <p class="product-inquiry-note">Wholesale pricing shown for reference. Final pricing depends on quantity, customization and packaging requirements.</p>

        <div class="product-facts">
          {% if product.metafields.custom.moq.value != blank %}<div><span>MOQ</span><strong>{{ product.metafields.custom.moq.value | escape }}</strong></div>{% endif %}
          {% if product.metafields.custom.material.value != blank %}<div><span>Material</span><strong>{{ product.metafields.custom.material.value | escape }}</strong></div>{% endif %}
          {% if product.metafields.custom.colors.value != blank %}<div><span>Colors</span><strong>{{ product.metafields.custom.colors.value | escape }}</strong></div>{% endif %}
          {% if product.metafields.custom.size.value != blank %}<div><span>Size</span><strong>{{ product.metafields.custom.size.value | escape }}</strong></div>{% endif %}
          {% if product.metafields.custom.packaging.value != blank %}<div><span>Packaging</span><strong>{{ product.metafields.custom.packaging.value | escape }}</strong></div>{% endif %}
          {% if product.metafields.custom.oem_odm.value != blank %}<div><span>OEM / ODM</span><strong>{{ product.metafields.custom.oem_odm.value | escape }}</strong></div>{% endif %}
        </div>

        <div class="product-actions">
          <a class="primary-link" href="/pages/contact-us">Request a Quote</a>
          {% if settings.whatsapp_url != blank %}<a class="secondary-link" href="{{ settings.whatsapp_url }}" target="_blank" rel="noopener">WhatsApp</a>{% endif %}
          {% if settings.email != blank %}<a class="secondary-link" href="mailto:{{ settings.email }}?subject=Quote%20Request%20-%20{{ product.title | url_encode }}">Email</a>{% endif %}
        </div>

        {% if product.description != blank %}
          <div class="product-description">
            <h2>Product Description</h2>
            {{ product.description }}
          </div>
        {% endif %}

        {% if product.metafields.custom.specifications.value != blank %}
          <div class="product-specifications">
            <h2>Specifications</h2>
            <div>{{ product.metafields.custom.specifications.value | newline_to_br }}</div>
          </div>
        {% endif %}
      </aside>
    </div>

    <div class="product-bottom-cta">
      <div>
        <p class="eyebrow">WHOLESALE · OEM / ODM · PRIVATE LABEL</p>
        <h2>Need this product customized?</h2>
        <p>Tell us your target quantity, colors, branding, packaging or other requirements.</p>
      </div>
      <a class="primary-link" href="/pages/contact-us">Start Your Inquiry</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "B2B product details",
  "settings": []
}
{% endschema %}