{{ 'oem-odm.css' | asset_url | stylesheet_tag }}
<section class="oem-reference">
  <div class="oem-wrap">
    <div class="oem-hero">
      <div class="oem-hero-media">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '900,1200,1600,2200', alt: section.settings.hero_image_alt }}{% endif %}</div>
      <div class="oem-hero-content">
        <p class="oem-kicker">{{ section.settings.hero_kicker }}</p>
        <h1>{{ section.settings.hero_title }}<span>{{ section.settings.hero_subtitle }}</span></h1>
        <p class="oem-hero-lead">{{ section.settings.hero_text }}</p>
        <a class="oem-btn" href="{{ section.settings.hero_button_link | default: '/pages/contact-us' }}">{{ section.settings.hero_button_label }}</a>
        <div class="oem-hero-trust"><span><i class="oem-icon">{% render 'oem-icon', icon: 'shield' %}</i>{{ section.settings.trust_1 }}</span><span><i class="oem-icon">{% render 'oem-icon', icon: 'tools' %}</i>{{ section.settings.trust_2 }}</span><span><i class="oem-icon">{% render 'oem-icon', icon: 'globe' %}</i>{{ section.settings.trust_3 }}</span></div>
      </div>
    </div>

    <div class="oem-benefits">{% for block in section.blocks %}{% if block.type == 'benefit' %}<div class="oem-benefit" {{ block.shopify_attributes }}><i class="oem-icon">{% render 'oem-icon', icon: block.settings.icon %}</i><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endif %}{% endfor %}</div>

    <div class="oem-section"><div class="oem-section-head"><h2>{{ section.settings.customize_heading }}</h2><p>{{ section.settings.customize_text }}</p></div><div class="oem-custom-grid">{% for block in section.blocks %}{% if block.type == 'customization' %}<div class="oem-custom-card" {{ block.shopify_attributes }}><div class="oem-custom-image {% if block.settings.image == blank %}oem-custom-image--empty{% endif %}">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', alt: block.settings.title }}{% else %}<span>{{ block.settings.title }}</span>{% endif %}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endif %}{% endfor %}</div></div>

    <div class="oem-section oem-process"><div class="oem-section-head"><h2>{{ section.settings.process_heading }}</h2><p>{{ section.settings.process_text }}</p></div><div class="oem-process-grid">{% for block in section.blocks %}{% if block.type == 'process' %}<div class="oem-step" {{ block.shopify_attributes }}><div class="oem-step-icon">{% render 'oem-icon', icon: block.settings.icon %}</div><div class="oem-step-num">{{ block.settings.number }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endif %}{% endfor %}</div></div>

    <div class="oem-section"><div class="oem-section-head"><h2>{{ section.settings.success_heading }}</h2><p>{{ section.settings.success_text }}</p></div><div class="oem-success-grid">{% for block in section.blocks %}{% if block.type == 'success' %}<div class="oem-success-card" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', alt: block.settings.title }}{% else %}<div class="oem-success-image"></div>{% endif %}<h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endif %}{% endfor %}</div></div>

    <div class="oem-cta"><div class="oem-cta-inner"><div><p class="oem-kicker">{{ section.settings.cta_kicker }}</p><h2>{{ section.settings.cta_title }}</h2><p>{{ section.settings.cta_text }}</p></div><a class="oem-btn" href="{{ section.settings.cta_link | default: '/pages/contact-us' }}">{{ section.settings.cta_label }}</a></div></div>
    <div class="oem-note">{{ section.settings.bottom_note }}</div>
  </div>
</section>

{% schema %}
