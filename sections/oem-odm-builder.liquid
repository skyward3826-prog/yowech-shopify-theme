    {"type":"success","name":"Success project","limit":6,"settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Food Storage Series"},{"type":"textarea","id":"text","label":"Text","default":"Custom colors and private label"}]}
