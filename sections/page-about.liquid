<style>
.about-hero{position:relative;min-height:430px;background:#edf1ed center/cover no-repeat;overflow:hidden}.about-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(247,244,238,.97) 0%,rgba(247,244,238,.88) 34%,rgba(247,244,238,.18) 68%,rgba(247,244,238,0) 100%)}.about-hero-inner{position:relative;z-index:1;min-height:430px;display:flex;flex-direction:column;justify-content:center}.about-hero-copy{max-width:570px}.about-hero h1{margin:0;font-size:clamp(40px,4.5vw,64px);line-height:1.02;letter-spacing:-.045em;color:#123d39}.about-hero-lead{max-width:520px;margin:14px 0 24px;color:#4f5b57;font-size:15px;line-height:1.55}.about-hero-points{display:flex;gap:28px;margin-top:28px;flex-wrap:wrap;font-size:12px;font-weight:600;color:#163d38}.about-company{display:grid;grid-template-columns:1.05fr 1.35fr;gap:42px;align-items:center;padding:42px 0}.about-image-wrap{background:#ebe7df;min-height:260px;overflow:hidden}.about-image-wrap img{width:100%;height:100%;min-height:260px;object-fit:cover}.about-copy h2,.about-factory h2,.about-values-row h2,.about-global h2{margin:0 0 12px;font-size:30px;line-height:1.12;letter-spacing:-.025em;color:#173f3a}.about-copy>p:last-child,.about-factory-copy>p:last-child,.about-values-row>div:first-child>p:last-child,.about-global p:last-child{color:#56615d;font-size:14px;line-height:1.6}.about-benefits{padding:34px 0;background:#edf4ef}.about-section-heading{text-align:left;max-width:380px;margin-bottom:24px}.about-section-heading h2{margin:0;font-size:30px;line-height:1.1;color:#173f3a}.about-benefit-grid{display:grid;grid-template-columns:repeat(4,1fr)}.about-benefit{padding:8px 24px;text-align:center;border-left:1px solid #d4dfd8}.about-icon{display:block;font-size:32px;line-height:1;margin-bottom:14px;color:#143d38}.about-benefit h3,.about-value-grid h3{margin:0 0 5px;font-size:14px;color:#173f3a}.about-benefit p,.about-value-grid p{margin:0;color:#59655f;font-size:11px;line-height:1.45}.about-factory{display:grid;grid-template-columns:.9fr 1.6fr;gap:38px;align-items:center;padding:48px 0}.about-factory-copy .primary-link{margin-top:16px}.about-factory-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.about-factory-grid img{width:100%;aspect-ratio:1.05/1;object-fit:cover;background:#ebe7df}.about-values-row{display:grid;grid-template-columns:1fr 2.1fr;gap:38px;padding:44px 0;background:#f7f4ee}.about-value-grid{display:grid;grid-template-columns:repeat(4,1fr)}.about-value-grid>div{text-align:center;padding:4px 16px;border-left:1px solid var(--line)}.about-value-grid .about-icon{font-size:27px}.about-global{display:grid;grid-template-columns:1fr 1fr;gap:42px;padding:46px 0;align-items:center}.about-cert-list{display:flex;gap:18px;align-items:center;margin-top:22px;flex-wrap:wrap}.about-cert-list span{font-weight:700;font-size:19px;color:#173f3a;border:1px solid #bfcac3;padding:8px 12px}.about-global-copy img{width:100%;max-height:190px;object-fit:cover;margin-top:16px}.about-final-cta{margin:0 0 0;min-height:150px;padding:38px 40px;display:flex;align-items:center;justify-content:space-between;gap:30px;background-color:#123f39;background-position:center;background-size:cover;color:#fff}.about-final-cta .eyebrow{color:#d7e4de}.about-final-cta h2{margin:0 0 7px;font-size:30px;line-height:1.1}.about-final-cta p:not(.eyebrow){margin:0;color:#dce5e1;font-size:13px}.about-final-cta .primary-link{background:#fff;color:#173f3a;white-space:nowrap}.about-final-cta .primary-link:hover{background:#edf3ef}
@media(max-width:900px){.about-hero,.about-hero-inner{min-height:520px}.about-company,.about-factory,.about-values-row,.about-global{grid-template-columns:1fr}.about-benefit-grid{grid-template-columns:repeat(2,1fr)}.about-factory-grid{grid-template-columns:repeat(2,1fr)}.about-value-grid{grid-template-columns:repeat(2,1fr);gap:20px}.about-value-grid>div:nth-child(odd){border-left:0}.about-final-cta{align-items:flex-start;flex-direction:column}}
@media(max-width:560px){.about-hero h1{font-size:39px}.about-hero-points{gap:12px;display:grid}.about-benefit-grid,.about-factory-grid,.about-value-grid{grid-template-columns:1fr}.about-benefit{border-left:0;border-top:1px solid #d4dfd8;padding:22px 10px}.about-value-grid>div{border-left:0!important;border-top:1px solid var(--line);padding-top:18px}.about-global{padding-inline:0}.about-final-cta{padding:30px 24px}}
</style>

<section class="business-page about-page">
  <div class="about-hero" {% if section.settings.hero_image != blank %}style="background-image:url('{{ section.settings.hero_image | image_url: width: 2200 }}')"{% endif %}>
    <div class="container about-hero-inner"><div class="about-hero-copy"><p class="eyebrow">{{ section.settings.hero_eyebrow }}</p><h1>{{ section.settings.hero_title }}</h1><p class="about-hero-lead">{{ section.settings.hero_description }}</p>{% if section.settings.hero_button != blank %}<a class="primary-link" href="{{ section.settings.hero_button_link }}">{{ section.settings.hero_button }}</a>{% endif %}</div><div class="about-hero-points"><span>{{ section.settings.hero_point_1 }}</span><span>{{ section.settings.hero_point_2 }}</span><span>{{ section.settings.hero_point_3 }}</span></div></div>
  </div>
  <div class="container">
    <div class="business-split about-company"><div class="about-image-wrap">{% if section.settings.company_image != blank %}<img src="{{ section.settings.company_image | image_url: width: 1200 }}" alt="{{ section.settings.company_image.alt | escape }}" loading="lazy">{% endif %}</div><div class="about-copy"><p class="eyebrow">{{ section.settings.company_eyebrow }}</p><h2>{{ section.settings.company_title }}</h2><p>{{ section.settings.company_text }}</p></div></div>
    <div class="about-benefits"><div class="about-section-heading"><p class="eyebrow">{{ section.settings.benefits_eyebrow }}</p><h2>{{ section.settings.benefits_title }}</h2></div><div class="about-benefit-grid">{% for block in section.blocks %}{% if block.type == 'benefit' %}<div class="about-benefit" {{ block.shopify_attributes }}><span class="about-icon">{{ block.settings.icon }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endif %}{% endfor %}</div></div>
    <div class="about-factory"><div class="about-factory-copy"><p class="eyebrow">{{ section.settings.factory_eyebrow }}</p><h2>{{ section.settings.factory_title }}</h2><p>{{ section.settings.factory_text }}</p>{% if section.settings.factory_button != blank %}<a class="primary-link" href="{{ section.settings.factory_button_link }}">{{ section.settings.factory_button }}</a>{% endif %}</div><div class="about-factory-grid">{% for image_id in 'factory_image_1,factory_image_2,factory_image_3,factory_image_4' | split: ',' %}{% assign img = section.settings[image_id] %}{% if img != blank %}<img src="{{ img | image_url: width: 900 }}" alt="Factory and production" loading="lazy">{% endif %}{% endfor %}</div></div>
    <div class="about-values-row"><div><p class="eyebrow">{{ section.settings.values_eyebrow }}</p><h2>{{ section.settings.values_title }}</h2><p>{{ section.settings.values_text }}</p></div><div class="about-value-grid">{% for block in section.blocks %}{% if block.type == 'value' %}<div {{ block.shopify_attributes }}><span class="about-icon">{{ block.settings.icon }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{% endif %}{% endfor %}</div></div>
    <div class="about-global"><div><p class="eyebrow">{{ section.settings.cert_eyebrow }}</p><h2>{{ section.settings.cert_title }}</h2><p>{{ section.settings.cert_text }}</p><div class="about-cert-list"><span>FDA</span><span>LFGB</span><span>BPA FREE</span><span>ISO</span></div></div><div class="about-global-copy"><p class="eyebrow">{{ section.settings.global_eyebrow }}</p><h2>{{ section.settings.global_title }}</h2><p>{{ section.settings.global_text }}</p>{% if section.settings.global_image != blank %}<img src="{{ section.settings.global_image | image_url: width: 1200 }}" alt="Global market reach" loading="lazy">{% endif %}</div></div>
    <div class="business-cta about-final-cta" {% if section.settings.cta_image != blank %}style="background-image:linear-gradient(rgba(7,45,40,.84),rgba(7,45,40,.84)),url('{{ section.settings.cta_image | image_url: width: 2200 }}')"{% endif %}><div><p class="eyebrow">{{ section.settings.cta_eyebrow }}</p><h2>{{ section.settings.cta_title }}</h2><p>{{ section.settings.cta_text }}</p></div><a class="primary-link" href="{{ section.settings.cta_button_link }}">{{ section.settings.cta_button }}</a></div>
  </div>
</section>

{% schema %}
{"name":"About Us page","settings":[{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"text","id":"hero_eyebrow","label":"Hero eyebrow","default":"ABOUT US"},{"type":"text","id":"hero_title","label":"Hero title","default":"Creating a Healthier and More Sustainable Life with Silicone"},{"type":"textarea","id":"hero_description","label":"Hero description","default":"We provide silicone products for global wholesalers, retailers, distributors and brands, with flexible wholesale supply and customization support."},{"type":"text","id":"hero_button","label":"Hero button","default":"Our Story"},{"type":"url","id":"hero_button_link","label":"Hero button link"},{"type":"text","id":"hero_point_1","label":"Hero point 1","default":"Reliable Quality"},{"type":"text","id":"hero_point_2","label":"Hero point 2","default":"Sustainable Materials"},{"type":"text","id":"hero_point_3","label":"Hero point 3","default":"Global B2B Support"},{"type":"image_picker","id":"company_image","label":"Company image"},{"type":"text","id":"company_eyebrow","label":"Company eyebrow","default":"OUR COMPANY"},{"type":"text","id":"company_title","label":"Company title","default":"Your Trusted Partner in Silicone Products"},{"type":"textarea","id":"company_text","label":"Company text","default":"We support global businesses with a broad silicone product range, practical sourcing solutions and flexible customization options. From existing products to custom projects, we help simplify the sourcing process."},{"type":"text","id":"benefits_eyebrow","label":"Benefits eyebrow","default":"WHY CHOOSE US"},{"type":"text","id":"benefits_title","label":"Benefits title","default":"More Than a Manufacturer. A Long-Term Partner"},{"type":"text","id":"factory_eyebrow","label":"Factory eyebrow","default":"OUR FACTORY"},{"type":"text","id":"factory_title","label":"Factory title","default":"Modern Production. Reliable Quality."},{"type":"textarea","id":"factory_text","label":"Factory text","default":"Our production partners support stable quality, efficient production and reliable bulk supply. Specific manufacturing capabilities and certifications can be updated here according to your actual situation."},{"type":"text","id":"factory_button","label":"Factory button","default":"Factory Tour"},{"type":"url","id":"factory_button_link","label":"Factory button link"},{"type":"image_picker","id":"factory_image_1","label":"Factory image 1"},{"type":"image_picker","id":"factory_image_2","label":"Factory image 2"},{"type":"image_picker","id":"factory_image_3","label":"Factory image 3"},{"type":"image_picker","id":"factory_image_4","label":"Factory image 4"},{"type":"text","id":"values_eyebrow","label":"Values eyebrow","default":"OUR VALUES"},{"type":"text","id":"values_title","label":"Values title","default":"Quality. Innovation. Responsibility."},{"type":"textarea","id":"values_text","label":"Values text","default":"We believe in reliable quality, continuous improvement and responsible business practices. Our goal is to build long-term partnerships with our customers."},{"type":"text","id":"cert_eyebrow","label":"Certifications eyebrow","default":"CERTIFICATIONS"},{"type":"text","id":"cert_title","label":"Certifications title","default":"International Standards You Can Trust"},{"type":"textarea","id":"cert_text","label":"Certifications text","default":"Update this section with the certifications and compliance information that applies to your actual products and target markets."},{"type":"text","id":"global_eyebrow","label":"Global reach eyebrow","default":"GLOBAL REACH"},{"type":"text","id":"global_title","label":"Global reach title","default":"Serving Customers Worldwide"},{"type":"textarea","id":"global_text","label":"Global reach text","default":"We support international B2B buyers with clear communication, flexible sourcing and coordinated delivery."},{"type":"image_picker","id":"global_image","label":"Global reach image"},{"type":"image_picker","id":"cta_image","label":"CTA background image"},{"type":"text","id":"cta_eyebrow","label":"CTA eyebrow","default":"LET'S BUILD A BETTER TOMORROW TOGETHER"},{"type":"text","id":"cta_title","label":"CTA title","default":"Work With Us"},{"type":"textarea","id":"cta_text","label":"CTA text","default":"Tell us what you are looking for and let's discuss how we can support your silicone products business."},{"type":"text","id":"cta_button","label":"CTA button","default":"Contact Us"},{"type":"url","id":"cta_button_link","label":"CTA button link"}],"blocks":[{"type":"benefit","name":"Why choose us","settings":[{"type":"text","id":"icon","label":"Icon","default":"◆"},{"type":"text","id":"title","label":"Title","default":"Professional R&D"},{"type":"textarea","id":"text","label":"Text","default":"Continuous product development for changing market needs."}]},{"type":"value","name":"Company value","settings":[{"type":"text","id":"icon","label":"Icon","default":"✓"},{"type":"text","id":"title","label":"Title","default":"Quality First"},{"type":"textarea","id":"text","label":"Text","default":"Safe and dependable products."}]}],"presets":[{"name":"About Us page","blocks":[{"type":"benefit","settings":{"icon":"⚙","title":"Professional R&D","text":"Continuous product development for changing market needs."}},{"type":"benefit","settings":{"icon":"◉","title":"Strict Quality Control","text":"From specifications to finished products."}},{"type":"benefit","settings":{"icon":"✕","title":"Flexible Customization","text":"OEM & ODM support for your brand."}},{"type":"benefit","settings":{"icon":"♢","title":"Customer-Oriented","text":"Your success is our priority."}},{"type":"value","settings":{"icon":"✓","title":"Quality First","text":"Safe and dependable products."}},{"type":"value","settings":{"icon":"✦","title":"Innovation Driven","text":"New ideas for better products."}},{"type":"value","settings":{"icon":"◌","title":"Sustainable Development","text":"Responsible materials and practices."}},{"type":"value","settings":{"icon":"◉","title":"People Oriented","text":"Customers and partners come first."}}]}]}
{% endschema %}