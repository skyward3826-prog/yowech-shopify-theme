<style>
.contact-reference{background:#fff;color:#173b36}.contact-reference__hero{position:relative;min-height:390px;overflow:hidden;background:#eef1ed}.contact-reference__hero-media{position:absolute;inset:0}.contact-reference__hero-media img{width:100%;height:100%;object-fit:cover}.contact-reference__hero-media:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(247,244,238,.98) 0%,rgba(247,244,238,.88) 34%,rgba(247,244,238,.28) 65%,rgba(247,244,238,0) 100%)}.contact-reference__hero-inner{position:relative;z-index:1;min-height:390px;display:flex;align-items:center}.contact-reference__hero-copy{max-width:570px;padding:48px 0}.contact-reference .eyebrow{margin:0 0 16px;color:#547067;font-size:11px;font-weight:700;letter-spacing:.16em}.contact-reference__hero h1{margin:0;font-size:clamp(42px,5vw,66px);line-height:1.02;letter-spacing:-.045em;color:#123b36}.contact-reference__hero h2{margin:10px 0 0;font-size:22px;line-height:1.2}.contact-reference__hero-copy>p:not(.eyebrow){max-width:540px;margin:16px 0 0;color:#52615b;font-size:15px;line-height:1.55}.contact-reference__hero-features{display:flex;flex-wrap:wrap;gap:12px 28px;margin-top:26px}.contact-reference__hero-features span{font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:7px}.contact-reference__hero-features span:before{content:'✓';font-size:16px}
.contact-reference__methods{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;padding:24px 0}.contact-reference__method{display:flex;align-items:center;gap:14px;padding:20px;background:#fff;border:1px solid #edf0ec;box-shadow:0 8px 25px rgba(23,59,54,.05);min-height:112px;text-decoration:none;color:inherit;transition:transform .2s ease,box-shadow .2s ease}.contact-reference__method:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(23,59,54,.09)}.contact-reference__icon{width:50px;height:50px;border-radius:50%;display:grid;place-items:center;flex:0 0 50px;background:#dcebe4;color:#173b36;overflow:hidden}.contact-reference__icon img{width:100%;height:100%;object-fit:contain;padding:8px}.contact-reference__method:nth-child(2) .contact-reference__icon{background:#d9eadc}.contact-reference__method:nth-child(3) .contact-reference__icon{background:#e4edf4}.contact-reference__method:nth-child(4) .contact-reference__icon{background:#dce7ee}.contact-reference__method small{display:block;color:#5e6964;font-size:11px;text-transform:uppercase;letter-spacing:.08em}.contact-reference__method strong{display:block;margin-top:4px;font-size:14px;line-height:1.3}.contact-reference__method em{display:block;margin-top:5px;color:#6b756f;font-size:11px;font-style:normal}
.contact-reference__inquiry{padding:4px 0 64px}.contact-reference__inquiry-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:24px}.contact-reference__panel{background:#f8faf8;border:1px solid #edf0ec}.contact-reference__form-panel{padding:32px}.contact-reference__panel h2{margin:0;font-size:30px;line-height:1.1;letter-spacing:-.025em}.contact-reference__panel>p{margin:8px 0 24px;color:#66716c;font-size:13px}.contact-reference__form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 16px}.contact-reference__form label{display:grid;gap:6px;font-size:12px;font-weight:600}.contact-reference__form input,.contact-reference__form select,.contact-reference__form textarea{width:100%;border:1px solid #dfe5e1;background:#fff;padding:12px 13px;font:inherit;font-size:12px;color:#173b36;border-radius:0}.contact-reference__form textarea{min-height:120px;resize:vertical}.contact-reference__form .full{grid-column:1/-1}.contact-reference__form button{border:0;cursor:pointer}.contact-reference__form .form-success{grid-column:1/-1;padding:12px;background:#e8f1eb;font-size:12px}.contact-reference__office{overflow:hidden;background:#fff}.contact-reference__office-copy{padding:32px}.contact-reference__office-row{display:flex;gap:13px;margin-top:20px}.contact-reference__office-symbol{font-size:23px;line-height:1}.contact-reference__office-row strong{display:block;font-size:13px}.contact-reference__office-row p{margin:3px 0 0;color:#66716c;font-size:12px;line-height:1.55;white-space:pre-line}.contact-reference__office-image{height:220px;background:#e8ece8}.contact-reference__office-image img{width:100%;height:100%;object-fit:cover}
.contact-reference__cta{position:relative;min-height:190px;overflow:hidden;background:#173b36;color:#fff}.contact-reference__cta-media{position:absolute;inset:0}.contact-reference__cta-media img{width:100%;height:100%;object-fit:cover}.contact-reference__cta-media:after{content:"";position:absolute;inset:0;background:rgba(8,47,40,.82)}.contact-reference__cta-inner{position:relative;z-index:1;min-height:190px;display:flex;align-items:center;justify-content:space-between;gap:30px}.contact-reference__cta-copy .eyebrow{color:#b9cec5;margin-bottom:8px}.contact-reference__cta h2{margin:0;font-size:36px;line-height:1.05;color:#fff}.contact-reference__cta p:not(.eyebrow){margin:9px 0 0;color:#dce6e1;font-size:13px}.contact-reference__cta .secondary-link{background:#fff;border-color:#fff;color:#173b36;padding:13px 24px;font-weight:600}.contact-reference__placeholder{height:100%;min-height:280px;display:grid;place-items:center;background:#e8ece8;color:#6a756f;font-size:12px}.contact-reference__hero .contact-reference__placeholder{min-height:390px}.contact-reference__cta .contact-reference__placeholder{min-height:190px;background:#173b36;color:#c9d8d2}
@media(max-width:900px){.contact-reference__methods{grid-template-columns:repeat(2,1fr)}.contact-reference__inquiry-grid{grid-template-columns:1fr}.contact-reference__hero{min-height:420px}.contact-reference__hero-inner{min-height:420px}.contact-reference__hero-media:after{background:linear-gradient(90deg,rgba(247,244,238,.97),rgba(247,244,238,.68) 65%,rgba(247,244,238,.2))}}@media(max-width:640px){.contact-reference__hero{min-height:540px}.contact-reference__hero-inner{min-height:540px;align-items:flex-end}.contact-reference__hero-copy{padding:38px 0}.contact-reference__hero h1{font-size:42px}.contact-reference__hero h2{font-size:19px}.contact-reference__methods{grid-template-columns:1fr;padding:14px 0}.contact-reference__inquiry{padding-bottom:40px}.contact-reference__form{grid-template-columns:1fr}.contact-reference__form .full{grid-column:auto}.contact-reference__form-panel,.contact-reference__office-copy{padding:24px}.contact-reference__cta-inner{align-items:flex-start;flex-direction:column;padding:36px 0}.contact-reference__cta .secondary-link{margin-bottom:5px}}
</style>
<section class="contact-reference">
  <div class="contact-reference__hero"><div class="contact-reference__hero-media">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '900,1400,1800,2200', sizes: '100vw', alt: section.settings.hero_image.alt | default: section.settings.hero_title }}{% else %}<div class="contact-reference__placeholder">Upload Contact Us hero image</div>{% endif %}</div><div class="container contact-reference__hero-inner"><div class="contact-reference__hero-copy"><p class="eyebrow">{{ section.settings.hero_label }}</p><h1>{{ section.settings.hero_title }}</h1><h2>{{ section.settings.hero_subtitle }}</h2><p>{{ section.settings.hero_text }}</p><div class="contact-reference__hero-features"><span>{{ section.settings.feature_1 }}</span><span>{{ section.settings.feature_2 }}</span><span>{{ section.settings.feature_3 }}</span></div></div></div></div>
  <div class="container"><div class="contact-reference__methods">
    <a class="contact-reference__method" href="mailto:{{ settings.email | escape }}"><span class="contact-reference__icon">{% if section.settings.email_icon != blank %}{{ section.settings.email_icon | image_url: width: 100 | image_tag: loading: 'lazy', alt: 'Email' }}{% else %}✉{% endif %}</span><span><small>Email Us</small><strong>{{ settings.email | default: 'sales@yourdomain.com' }}</strong><em>Send us an email anytime.</em></span></a>
    <a class="contact-reference__method" href="{{ settings.whatsapp_url | default: '#' }}" {% if settings.whatsapp_url != blank %}target="_blank" rel="noopener"{% endif %}><span class="contact-reference__icon">{% if section.settings.whatsapp_icon != blank %}{{ section.settings.whatsapp_icon | image_url: width: 100 | image_tag: loading: 'lazy', alt: 'WhatsApp' }}{% else %}◉{% endif %}</span><span><small>Chat on WhatsApp</small><strong>Chat with our sales team</strong><em>Get a faster response via WhatsApp.</em></span></a>
    <a class="contact-reference__method" href="{{ settings.facebook_url | default: '#' }}" {% if settings.facebook_url != blank %}target="_blank" rel="noopener"{% endif %}><span class="contact-reference__icon">{% if section.settings.facebook_icon != blank %}{{ section.settings.facebook_icon | image_url: width: 100 | image_tag: loading: 'lazy', alt: 'Facebook' }}{% else %}f{% endif %}</span><span><small>Message on Facebook</small><strong>Follow &amp; message us</strong><em>Connect with our team online.</em></span></a>
    <a class="contact-reference__method" href="{{ settings.linkedin_url | default: '#' }}" {% if settings.linkedin_url != blank %}target="_blank" rel="noopener"{% endif %}><span class="contact-reference__icon">{% if section.settings.linkedin_icon != blank %}{{ section.settings.linkedin_icon | image_url: width: 100 | image_tag: loading: 'lazy', alt: 'LinkedIn' }}{% else %}in{% endif %}</span><span><small>Connect on LinkedIn</small><strong>Connect with our team</strong><em>Build a long-term business relationship.</em></span></a>
  </div></div>
  <div class="container"><div class="contact-reference__inquiry"><div class="contact-reference__inquiry-grid"><div class="contact-reference__panel contact-reference__form-panel"><p class="eyebrow">{{ section.settings.form_label }}</p><h2>{{ section.settings.form_title }}</h2><p>{{ section.settings.form_intro }}</p>{% form 'contact', id: 'B2BInquiryForm', class: 'contact-reference__form' %}{% if form.posted_successfully? %}<div class="form-success">Thank you. Your inquiry has been received. We’ll get back to you shortly.</div>{% endif %}{{ form.errors | default_errors }}<label>Full Name *<input type="text" name="contact[name]" required placeholder="Your name"></label><label>Company Name *<input type="text" name="contact[company]" required placeholder="Your company"></label><label>Business Email *<input type="email" name="contact[email]" required placeholder="Your email"></label><label>Phone / WhatsApp<input type="text" name="contact[phone]" placeholder="Your phone number"></label><label>Inquiry Type *<select name="contact[inquiry_type]" required><option value="">Please select</option><option>Wholesale Products</option><option>OEM / ODM</option><option>Private Label</option><option>Other</option></select></label><label>Target Market<select name="contact[target_market]"><option value="">Please select</option><option>North America</option><option>Europe</option><option>Asia</option><option>Australia / New Zealand</option><option>Other</option></select></label><label class="full">Your Message *<textarea name="contact[body]" rows="6" required placeholder="Tell us about your needs, products, quantity, target price, packaging or other requirements."></textarea></label><button class="primary-link form-submit" type="submit">{{ section.settings.form_button }} →</button>{% endform %}</div><div class="contact-reference__panel contact-reference__office"><div class="contact-reference__office-copy"><p class="eyebrow">{{ section.settings.office_label }}</p><h2>{{ section.settings.office_title }}</h2><p>{{ section.settings.office_intro }}</p><div class="contact-reference__office-row"><span class="contact-reference__office-symbol">⌖</span><div><strong>{{ section.settings.office_location }}</strong><p>{{ section.settings.office_address }}</p></div></div><div class="contact-reference__office-row"><span class="contact-reference__office-symbol">◷</span><div><strong>{{ section.settings.hours_title }}</strong><p>{{ section.settings.office_hours }}</p></div></div></div><div class="contact-reference__office-image">{% if section.settings.office_image != blank %}{{ section.settings.office_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 901px) 40vw, 100vw', alt: section.settings.office_image.alt | default: section.settings.office_title }}{% else %}<div class="contact-reference__placeholder">Upload office image</div>{% endif %}</div></div></div></div></div>
  <div class="contact-reference__cta"><div class="contact-reference__cta-media">{% if section.settings.cta_image != blank %}{{ section.settings.cta_image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '900,1400,1800,2200', sizes: '100vw', alt: section.settings.cta_image.alt | default: section.settings.cta_title }}{% endif %}</div><div class="container contact-reference__cta-inner"><div class="contact-reference__cta-copy"><p class="eyebrow">{{ section.settings.cta_label }}</p><h2>{{ section.settings.cta_title }}</h2><p>{{ section.settings.cta_text }}</p></div><a class="secondary-link" href="{{ pages['contact-us'].url | default: '/pages/contact-us' }}">{{ section.settings.cta_button }} →</a></div></div>
</section>
{% schema %}
{"name":"Contact Us page","settings":[{"type":"image_picker","id":"hero_image","label":"Hero image","info":"Wide lifestyle image for the top banner."},{"type":"text","id":"hero_label","label":"Hero label","default":"CONTACT US"},{"type":"text","id":"hero_title","label":"Hero title","default":"Let’s Work Together"},{"type":"text","id":"hero_subtitle","label":"Hero subtitle","default":"Your Trusted Partner for Silicone Products"},{"type":"textarea","id":"hero_text","label":"Hero text","default":"Have a question, a project idea, or a quote request? We’re here to help. Reach out to us through the form or any of the contact methods below."},{"type":"text","id":"feature_1","label":"Hero feature 1","default":"Professional Support"},{"type":"text","id":"feature_2","label":"Hero feature 2","default":"Quick Response"},{"type":"text","id":"feature_3","label":"Hero feature 3","default":"Global Cooperation"},{"type":"image_picker","id":"email_icon","label":"Email icon"},{"type":"image_picker","id":"whatsapp_icon","label":"WhatsApp icon"},{"type":"image_picker","id":"facebook_icon","label":"Facebook icon"},{"type":"image_picker","id":"linkedin_icon","label":"LinkedIn icon"},{"type":"text","id":"form_label","label":"Form label","default":"B2B INQUIRY"},{"type":"text","id":"form_title","label":"Form title","default":"Send Us a Message"},{"type":"textarea","id":"form_intro","label":"Form intro","default":"Fill in the form below and we will get back to you shortly."},{"type":"text","id":"form_button","label":"Form button","default":"Send Message"},{"type":"text","id":"office_label","label":"Office label","default":"OUR OFFICE"},{"type":"text","id":"office_title","label":"Office title","default":"Let’s Talk About Your Business"},{"type":"textarea","id":"office_intro","label":"Office intro","default":"You are always welcome to contact us. Let’s discuss how we can work together."},{"type":"text","id":"office_location","label":"Office location","default":"Your Office Location"},{"type":"textarea","id":"office_address","label":"Office address","default":"Add your actual office address here."},{"type":"text","id":"hours_title","label":"Business hours title","default":"Business Hours"},{"type":"textarea","id":"office_hours","label":"Business hours","default":"Mon - Fri: 9:00 AM - 6:00 PM\nSat - Sun: Closed"},{"type":"image_picker","id":"office_image","label":"Office image"},{"type":"image_picker","id":"cta_image","label":"CTA background image","info":"Wide background image for the final CTA."},{"type":"text","id":"cta_label","label":"CTA label","default":"READY TO START YOUR PROJECT?"},{"type":"text","id":"cta_title","label":"CTA title","default":"Get in Touch Today"},{"type":"textarea","id":"cta_text","label":"CTA text","default":"Tell us your needs and let’s create something great together."},{"type":"text","id":"cta_button","label":"CTA button","default":"Contact Us"}]}
{% endschema %}