{{ 'oem-odm.css' | asset_url | stylesheet_tag }}

<section class="oem-reference">
  <div class="oem-wrap">
    <div class="oem-hero">
      <div class="oem-hero-media">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '900,1200,1600,2200', alt: 'Silicone products OEM and ODM' }}
        {% endif %}
      </div>
      <div class="oem-hero-content">
        <p class="oem-kicker">OEM &amp; ODM</p>
        <h1>{{ section.settings.hero_title }}<span>{{ section.settings.hero_subtitle }}</span></h1>
        <p class="oem-hero-lead">{{ section.settings.hero_text }}</p>
        <a class="oem-btn" href="{{ section.settings.hero_button_link | default: '/pages/contact-us' }}">{{ section.settings.hero_button_label }}</a>
        <div class="oem-hero-trust">
          <span><i class="oem-icon">{% render 'oem-icon', icon: 'shield' %}</i>Reliable Quality</span>
          <span><i class="oem-icon">{% render 'oem-icon', icon: 'tools' %}</i>Flexible Customization</span>
          <span><i class="oem-icon">{% render 'oem-icon', icon: 'globe' %}</i>Worldwide Shipping</span>
        </div>
      </div>
    </div>

    <div class="oem-benefits">
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <div class="oem-benefit" {{ block.shopify_attributes }}>
            <i class="oem-icon">{% render 'oem-icon', icon: block.settings.icon %}</i>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="oem-section">
      <div class="oem-section-head">
        <h2>What Can We Customize?</h2>
        <p>We offer a full range of customization options to meet your market needs.</p>
      </div>
      <div class="oem-custom-grid">
        {% for block in section.blocks %}
          {% if block.type == 'customization' %}
            <div class="oem-custom-card" {{ block.shopify_attributes }}>
              <div class="oem-custom-image {% if block.settings.image == blank %}oem-custom-image--empty{% endif %}">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', alt: block.settings.title }}
                {% else %}
                  <span>{{ block.settings.title }}</span>
                {% endif %}
              </div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="oem-section oem-process">
      <div class="oem-section-head">
        <h2>Our OEM &amp; ODM Process</h2>
        <p>A clear and efficient process to ensure your project runs smoothly.</p>
      </div>
      <div class="oem-process-grid">
        {% for block in section.blocks %}
          {% if block.type == 'process' %}
            <div class="oem-step" {{ block.shopify_attributes }}>
              <div class="oem-step-icon">{% render 'oem-icon', icon: block.settings.icon %}</div>
              <div class="oem-step-num">{{ block.settings.number }}</div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="oem-section">
      <div class="oem-section-head">
        <h2>Our Success Projects</h2>
        <p>Helping global brands create high-quality silicone products.</p>
      </div>
      <div class="oem-success-grid">
        {% for block in section.blocks %}
          {% if block.type == 'success' %}
            <div class="oem-success-card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', alt: block.settings.title }}
              {% else %}
                <div class="oem-success-image"></div>
              {% endif %}
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="oem-cta">
      <div class="oem-cta-inner">
        <div>
          <p class="oem-kicker">LET'S CREATE SOMETHING GREAT TOGETHER</p>
          <h2>Ready to Start Your OEM &amp; ODM Project?</h2>
          <p>Contact us today to discuss your ideas and get a customized solution for your business.</p>
        </div>
        <a class="oem-btn" href="{{ section.settings.cta_link | default: '/pages/contact-us' }}">{{ section.settings.cta_label }}</a>
      </div>
    </div>
    <div class="oem-note">Wholesale supply · OEM / ODM · Private Label · Global B2B Support</div>
  </div>
</section>

{% schema %}
{
  "name": "OEM & ODM page",
  "settings": [
    {"type":"image_picker","id":"hero_image","label":"Hero image","info":"Use a wide lifestyle image of silicone products. Recommended 2200 × 900 px."},
    {"type":"text","id":"hero_title","label":"Hero title","default":"Turn Your Ideas into High-Quality"},
    {"type":"text","id":"hero_subtitle","label":"Hero subtitle","default":"Silicone Products"},
    {"type":"textarea","id":"hero_text","label":"Hero description","default":"From concept to mass production, we provide professional OEM & ODM services to help you create unique silicone products for your brand and market."},
    {"type":"text","id":"hero_button_label","label":"Hero button","default":"Start Your Project"},
    {"type":"url","id":"hero_button_link","label":"Hero button link"},
    {"type":"text","id":"cta_label","label":"Bottom CTA button","default":"Contact Us"},
    {"type":"url","id":"cta_link","label":"Bottom CTA link"}
  ],
  "blocks": [
    {"type":"benefit","name":"Benefit","limit":4,"settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"idea","label":"Idea"},{"value":"gear","label":"Gear"},{"value":"factory","label":"Factory"},{"value":"people","label":"People"}],"default":"idea"},{"type":"text","id":"title","label":"Title","default":"Bring Your Ideas to Life"},{"type":"textarea","id":"text","label":"Text","default":"From concept to finished product."}]},
    {"type":"customization","name":"Customization card","limit":6,"settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Product Design"},{"type":"textarea","id":"text","label":"Text","default":"Custom shapes and functions."}]},
    {"type":"process","name":"Process step","limit":6,"settings":[{"type":"text","id":"number","label":"Number","default":"01"},{"type":"select","id":"icon","label":"Icon","options":[{"value":"chat","label":"Chat"},{"value":"document","label":"Document"},{"value":"box","label":"Box"},{"value":"check","label":"Check"},{"value":"truck","label":"Truck"}],"default":"chat"},{"type":"text","id":"title","label":"Title","default":"Consultation"},{"type":"textarea","id":"text","label":"Text","default":"Discuss your ideas and requirements."}]},
    {"type":"success","name":"Success project","limit":6,"settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Food Storage Series"},{"type":"text","id":"text","label":"Text","default":"Custom colors and private label"}]}
  ],
  "presets": [{"name":"OEM & ODM reference page","blocks":[{"type":"benefit","settings":{"icon":"idea","title":"Bring Your Ideas to Life","text":"From concept to finished product."}},{"type":"benefit","settings":{"icon":"gear","title":"Custom Design","text":"Shape, size, color, logo, packaging and more."}},{"type":"benefit","settings":{"icon":"factory","title":"Professional Manufacturing","text":"Stable quality and large-scale production."}},{"type":"benefit","settings":{"icon":"people","title":"Your Reliable Partner","text":"Long-term support for global brands and businesses."}},{"type":"customization","settings":{"title":"Product Design","text":"Custom shapes and functions."}},{"type":"customization","settings":{"title":"Color Customization","text":"Pantone colors or custom colors."}},{"type":"customization","settings":{"title":"Logo & Branding","text":"Silk printing, laser engraving, debossing, embossing."}},{"type":"customization","settings":{"title":"Packaging","text":"Custom packaging and private label."}},{"type":"customization","settings":{"title":"Material","text":"Food-grade, BPA-free, LFGB, FDA and more."}},{"type":"customization","settings":{"title":"Function & Structure","text":"Customized to your specific needs."}},{"type":"process","settings":{"number":"01","icon":"chat","title":"Consultation","text":"Discuss your ideas and requirements."}},{"type":"process","settings":{"number":"02","icon":"document","title":"Design & Proposal","text":"Provide drawings and quotation."}},{"type":"process","settings":{"number":"03","icon":"box","title":"Sample Development","text":"Make samples for confirmation."}},{"type":"process","settings":{"number":"04","icon":"check","title":"Mass Production","text":"Start production after sample approval."}},{"type":"process","settings":{"number":"05","icon":"box","title":"Quality Control","text":"Strict quality inspection before shipment."}},{"type":"process","settings":{"number":"06","icon":"truck","title":"Shipping","text":"Worldwide delivery with reliable partners."}},{"type":"success","settings":{"title":"Food Storage Series","text":"Custom colors and private label"}},{"type":"success","settings":{"title":"Baby Products","text":"OEM for international brands"}},{"type":"success","settings":{"title":"Pet Products","text":"Custom design and logo"}},{"type":"success","settings":{"title":"Outdoor & Sports","text":"Customized for bulk orders"}},{"type":"success","settings":{"title":"Beauty & Personal Care","text":"OEM with custom packaging"}},{"type":"success","settings":{"title":"Bathroom Products","text":"Custom shapes and colors"}}]}
  ]
}
{% endschema %}
