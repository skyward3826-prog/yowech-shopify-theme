<section class="wholesale-page">
  <style>
    .wholesale-page{background:#f7f4ee;color:#202522}
    .wholesale-page .container{width:min(calc(100% - 48px),1320px);margin:0 auto}
    .wholesale-hero{position:relative;min-height:500px;display:flex;align-items:center;overflow:hidden;background:#e8e3d9}
    .wholesale-hero__media{position:absolute;inset:0}
    .wholesale-hero__media img{width:100%;height:100%;object-fit:cover}
    .wholesale-hero__media:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(247,244,238,.97) 0%,rgba(247,244,238,.86) 35%,rgba(247,244,238,.25) 68%,rgba(247,244,238,0) 100%)}
    .wholesale-hero__copy{position:relative;z-index:1;max-width:650px;padding:80px 0}
    .wholesale-page .eyebrow{margin:0 0 16px;color:#3e5147;font-size:11px;font-weight:700;letter-spacing:.16em}
    .wholesale-hero h1{margin:0;font-size:clamp(42px,5vw,68px);line-height:1.02;letter-spacing:-.045em;color:#173b36}
    .wholesale-hero__lead{max-width:590px;margin:22px 0 28px;color:#4f5752;font-size:17px;line-height:1.55}
    .wholesale-page .primary-link{display:inline-block;padding:13px 22px;background:#202522;color:#fff;font-size:13px}
    .wholesale-benefits{display:grid;grid-template-columns:repeat(4,1fr);background:#edf3ee;border-top:1px solid #d3ddd5;border-bottom:1px solid #d3ddd5}
    .wholesale-benefit{padding:36px 26px;text-align:center;border-right:1px solid #d3ddd5}
    .wholesale-benefit:last-child{border-right:0}
    .wholesale-benefit__number{display:block;margin-bottom:12px;color:#5f7668;font-size:11px;letter-spacing:.12em;font-weight:700}
    .wholesale-benefit h2{margin:0 0 7px;font-size:18px;color:#173b36}
    .wholesale-benefit p{margin:0;color:#66716c;font-size:12px;line-height:1.5}
    .wholesale-sourcing{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;background:#fff;padding:72px 0}
    .wholesale-sourcing__media{min-height:420px;background:#ebe7df;overflow:hidden}
    .wholesale-sourcing__media img{width:100%;height:100%;object-fit:cover}
    .wholesale-sourcing__copy{display:flex;flex-direction:column;justify-content:center;padding:55px 8%}
    .wholesale-sourcing__copy h2{margin:0;font-size:clamp(32px,3.5vw,50px);line-height:1.05;letter-spacing:-.035em;color:#173b36}
    .wholesale-sourcing__copy>p:not(.eyebrow){margin:20px 0 25px;color:#66716c;font-size:15px;line-height:1.65}
    .wholesale-steps{padding:72px 0;background:#edf3ee;text-align:center}
    .wholesale-steps__heading{max-width:760px;margin:0 auto 42px}
    .wholesale-steps__heading h2{margin:0;color:#173b36;font-size:clamp(32px,3.5vw,48px);line-height:1.05}
    .wholesale-steps__heading p:not(.eyebrow){margin:12px 0 0;color:#66716c;font-size:14px}
    .wholesale-step-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0}
    .wholesale-step{padding:10px 28px;border-right:1px solid #cfdad2}
    .wholesale-step:last-child{border-right:0}
    .wholesale-step strong{display:inline-grid;place-items:center;width:58px;height:58px;border:1px solid #5f7668;border-radius:50%;color:#173b36;font-size:13px}
    .wholesale-step h3{margin:17px 0 7px;font-size:16px;color:#173b36}
    .wholesale-step p{margin:0;color:#66716c;font-size:12px;line-height:1.5}
    .wholesale-cta{position:relative;overflow:hidden;background:#173b36;color:#fff;padding:68px 0}
    .wholesale-cta__media{position:absolute;inset:0;opacity:.3}
    .wholesale-cta__media img{width:100%;height:100%;object-fit:cover}
    .wholesale-cta__inner{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:40px}
    .wholesale-cta h2{margin:0;font-size:clamp(30px,3.5vw,46px);line-height:1.08}
    .wholesale-cta p:not(.eyebrow){max-width:720px;margin:12px 0 0;color:#dce5df;font-size:14px}
    .wholesale-cta .primary-link{background:#fff;color:#173b36;white-space:nowrap}
    @media(max-width:900px){
      .wholesale-benefits{grid-template-columns:repeat(2,1fr)}
      .wholesale-benefit:nth-child(2){border-right:0}
      .wholesale-sourcing{grid-template-columns:1fr;padding:50px 0}
      .wholesale-sourcing__media{min-height:330px}
      .wholesale-step-grid{grid-template-columns:repeat(2,1fr);row-gap:30px}
      .wholesale-step:nth-child(2){border-right:0}
      .wholesale-cta__inner{align-items:flex-start;flex-direction:column}
    }
    @media(max-width:600px){
      .wholesale-page .container{width:min(calc(100% - 32px),1320px)}
      .wholesale-hero{min-height:540px}
      .wholesale-hero__copy{padding:55px 0}
      .wholesale-hero h1{font-size:42px}
      .wholesale-hero__lead{font-size:15px}
      .wholesale-benefits{grid-template-columns:1fr}
      .wholesale-benefit{border-right:0!important;border-bottom:1px solid #d3ddd5}
      .wholesale-benefit:last-child{border-bottom:0}
      .wholesale-sourcing__copy{padding:45px 0}
      .wholesale-step-grid{grid-template-columns:1fr}
      .wholesale-step{border-right:0;border-bottom:1px solid #cfdad2;padding-bottom:28px}
      .wholesale-step:last-child{border-bottom:0}
    }
  </style>

  <div class="wholesale-hero">
    {% if section.settings.hero_image != blank %}
      <div class="wholesale-hero__media"><img src="{{ section.settings.hero_image | image_url: width: 2200 }}" alt="{{ section.settings.hero_image.alt | escape }}" loading="eager"></div>
    {% endif %}
    <div class="container">
      <div class="wholesale-hero__copy">
        <p class="eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1>{{ section.settings.hero_title }}</h1>
        <p class="wholesale-hero__lead">{{ section.settings.hero_description }}</p>
        {% if section.settings.hero_button_label != blank %}<a class="primary-link" href="{{ section.settings.hero_button_link }}">{{ section.settings.hero_button_label }}</a>{% endif %}
      </div>
    </div>
  </div>

  <div class="wholesale-benefits">
    {% for block in section.blocks %}
      {% if block.type == 'benefit' %}
        <div class="wholesale-benefit" {{ block.shopify_attributes }}>
          <span class="wholesale-benefit__number">{{ block.settings.number }}</span>
          <h2>{{ block.settings.title }}</h2>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="wholesale-sourcing">
    <div class="wholesale-sourcing__media">
      {% if section.settings.sourcing_image != blank %}<img src="{{ section.settings.sourcing_image | image_url: width: 1400 }}" alt="{{ section.settings.sourcing_image.alt | escape }}" loading="lazy">{% else %}<div class="image-placeholder">Add sourcing image</div>{% endif %}
    </div>
    <div class="wholesale-sourcing__copy">
      <p class="eyebrow">{{ section.settings.sourcing_eyebrow }}</p>
      <h2>{{ section.settings.sourcing_title }}</h2>
      <p>{{ section.settings.sourcing_text }}</p>
      {% if section.settings.sourcing_button_label != blank %}<a class="text-link" href="{{ section.settings.sourcing_button_link }}">{{ section.settings.sourcing_button_label }} →</a>{% endif %}
    </div>
  </div>

  <div class="wholesale-steps">
    <div class="container">
      <div class="wholesale-steps__heading">
        <p class="eyebrow">{{ section.settings.steps_eyebrow }}</p>
        <h2>{{ section.settings.steps_title }}</h2>
        <p>{{ section.settings.steps_description }}</p>
      </div>
      <div class="wholesale-step-grid">
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <div class="wholesale-step" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.number }}</strong>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="wholesale-cta">
    {% if section.settings.cta_image != blank %}<div class="wholesale-cta__media"><img src="{{ section.settings.cta_image | image_url: width: 2200 }}" alt="{{ section.settings.cta_image.alt | escape }}" loading="lazy"></div>{% endif %}
    <div class="container wholesale-cta__inner">
      <div>
        <p class="eyebrow">{{ section.settings.cta_eyebrow }}</p>
        <h2>{{ section.settings.cta_title }}</h2>
        <p>{{ section.settings.cta_text }}</p>
      </div>
      {% if section.settings.cta_button_label != blank %}<a class="primary-link" href="{{ section.settings.cta_button_link }}">{{ section.settings.cta_button_label }}</a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wholesale page",
  "settings": [
    {"type":"image_picker","id":"hero_image","label":"Hero image","info":"Recommended 2200 × 900 px wide lifestyle image."},
    {"type":"text","id":"hero_eyebrow","label":"Hero eyebrow","default":"WHOLESALE · GLOBAL SUPPLY"},
    {"type":"text","id":"hero_title","label":"Hero title","default":"Silicone Products Wholesale"},
    {"type":"textarea","id":"hero_description","label":"Hero description","default":"Source a wide range of silicone products from one reliable B2B partner, with flexible quantities, private label support and global shipping."},
    {"type":"text","id":"hero_button_label","label":"Hero button","default":"Request Wholesale Pricing"},
    {"type":"url","id":"hero_button_link","label":"Hero button link"},
    {"type":"image_picker","id":"sourcing_image","label":"Sourcing section image","info":"Recommended lifestyle or product collection image."},
    {"type":"text","id":"sourcing_eyebrow","label":"Sourcing eyebrow","default":"WHOLESALE SOURCING"},
    {"type":"text","id":"sourcing_title","label":"Sourcing title","default":"One Supplier for Multiple Silicone Categories"},
    {"type":"textarea","id":"sourcing_text","label":"Sourcing description","default":"Build your silicone product range without managing multiple suppliers. Explore kitchenware, food storage, baby, pet, household, bathroom, beauty and outdoor products through one sourcing partner."},
    {"type":"text","id":"sourcing_button_label","label":"Sourcing button","default":"Explore Products"},
    {"type":"url","id":"sourcing_button_link","label":"Sourcing button link"},
    {"type":"text","id":"steps_eyebrow","label":"Process eyebrow","default":"HOW TO ORDER"},
    {"type":"text","id":"steps_title","label":"Process title","default":"A Simple B2B Sourcing Process"},
    {"type":"textarea","id":"steps_description","label":"Process description","default":"From product selection to delivery, we keep wholesale sourcing clear and efficient."},
    {"type":"image_picker","id":"cta_image","label":"CTA background image","info":"Optional. Use a dark lifestyle or product image."},
    {"type":"text","id":"cta_eyebrow","label":"CTA eyebrow","default":"READY TO SOURCE?"},
    {"type":"text","id":"cta_title","label":"CTA title","default":"Tell Us What You Need."},
    {"type":"textarea","id":"cta_text","label":"CTA description","default":"Send your product list, target quantity or market requirements and our sales team will get back to you."},
    {"type":"text","id":"cta_button_label","label":"CTA button","default":"Start an Inquiry"},
    {"type":"url","id":"cta_button_link","label":"CTA button link"}
  ],
  "blocks": [
    {"type":"benefit","name":"Wholesale benefit","limit":4,"settings":[
      {"type":"text","id":"number","label":"Number","default":"01"},
      {"type":"text","id":"title","label":"Title","default":"Wide Product Selection"},
      {"type":"textarea","id":"text","label":"Description","default":"Multiple silicone categories and product options for different markets and customer needs."}
    ]},
    {"type":"step","name":"Wholesale step","limit":4,"settings":[
      {"type":"text","id":"number","label":"Number","default":"01"},
      {"type":"text","id":"title","label":"Title","default":"Select Products"},
      {"type":"textarea","id":"text","label":"Description","default":"Browse categories and product details."}
    ]}
  ],
  "presets": [{"name":"Wholesale page","blocks":[
    {"type":"benefit","settings":{"number":"01","title":"Wide Product Selection","text":"Multiple silicone categories and product options for different markets and customer needs."}},
    {"type":"benefit","settings":{"number":"02","title":"Flexible MOQ","text":"Choose suitable quantities for test orders, launches and regular wholesale supply."}},
    {"type":"benefit","settings":{"number":"03","title":"Private Label Ready","text":"Customize products, colors, branding and packaging for your own market."}},
    {"type":"benefit","settings":{"number":"04","title":"Global B2B Support","text":"Clear communication from product selection and quotation through delivery."}},
    {"type":"step","settings":{"number":"01","title":"Select Products","text":"Browse categories and product details."}},
    {"type":"step","settings":{"number":"02","title":"Send Requirements","text":"Tell us quantity, market and customization needs."}},
    {"type":"step","settings":{"number":"03","title":"Receive a Quote","text":"We confirm pricing, MOQ, packaging and lead time."}},
    {"type":"step","settings":{"number":"04","title":"Production & Delivery","text":"Confirm the order and move into production and shipment."}}
  ]}]
}
{% endschema %}