{%- comment -%}
  Global structured data for YOWECH.
  Product rich data remains handled by Shopify's native product structured_data output.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ shop.url }}#organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}{% if settings.logo != blank %},
      "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}{% endif %}{% if settings.email != blank %},
      "email": {{ settings.email | json }}{% endif %}{% if settings.facebook_url != blank or settings.linkedin_url != blank %},
      "sameAs": [{% if settings.facebook_url != blank %}{{ settings.facebook_url | json }}{% endif %}{% if settings.facebook_url != blank and settings.linkedin_url != blank %},{% endif %}{% if settings.linkedin_url != blank %}{{ settings.linkedin_url | json }}{% endif %}]{% endif %}
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}#website",
      "url": {{ shop.url | json }},
      "name": {{ shop.name | json }},
      "publisher": {"@id": "{{ shop.url }}#organization"}
    },
    {
      "@type": "WebPage",
      "@id": "{{ canonical_url }}#webpage",
      "url": {{ canonical_url | json }},
      "name": {{ page_title | json }}{% if page_description %},
      "description": {{ page_description | json }}{% endif %},
      "isPartOf": {"@id": "{{ shop.url }}#website"}
    }{% if request.page_type == 'collection' %},
    {
      "@type": "CollectionPage",
      "@id": "{{ canonical_url }}#collection",
      "url": {{ canonical_url | json }},
      "name": {{ collection.title | json }},
      "isPartOf": {"@id": "{{ shop.url }}#website"}
    }{% endif %},
    {
      "@type": "BreadcrumbList",
      "@id": "{{ canonical_url }}#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        }{% if request.page_type == 'collection' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Products",
          "item": {{ routes.collections_url | prepend: shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ collection.title | json }},
          "item": {{ canonical_url | json }}
        }{% elsif request.page_type == 'product' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Products",
          "item": {{ routes.collections_url | prepend: shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": {{ canonical_url | json }}
        }{% elsif request.page_type == 'page' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ page.title | json }},
          "item": {{ canonical_url | json }}
        }{% endif %}
      ]
    }
  ]
}
</script>